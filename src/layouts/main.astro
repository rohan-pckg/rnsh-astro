---
import "@/styles/global.css"
import DoodleIconSprite from "@/components/DoodleIconSprite.astro"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/pfp.png" />
    <title>\(^-^)/</title>
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme")
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark"
        }
        return "light"
      })()

      if (theme === "dark") {
        document.documentElement.classList.add("dark")
      } else {
        document.documentElement.classList.remove("dark")
      }
      window.localStorage.setItem("theme", theme)
    </script>
  </head>
  <body class="bg-background text-foreground">
    <DoodleIconSprite />
    <main>
      <slot />
    </main>
    <script>
      import { isSoundCategory, playSound } from "@/lib/sound"
      import type { SoundVariant } from "@/lib/sound"

      document.addEventListener("click", (event) => {
        const target = (event.target as Element | null)?.closest<HTMLElement>(
          "[data-sound-category]"
        )
        if (!target) return

        const category = target.dataset.soundCategory
        const variant = target.dataset.soundVariant as SoundVariant | undefined
        if (category && isSoundCategory(category)) {
          playSound(category, { variant })
        }
      })
    </script>
  </body>
</html>
