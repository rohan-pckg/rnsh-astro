---
import BackButton from "@/components/article/BackButton"
import CopyLinkButton from "@/components/article/CopyLinkButton"

export interface Props {
  title: string
  backHref?: string
}

const { title, backHref = "/writing" } = Astro.props
---

<div class="article-shell mb-8 flex min-h-10 items-center gap-6">
  <BackButton fallbackHref={backHref} client:load />
  <h1 class="nav-title min-w-0 flex-1 truncate">{title}</h1>
  <CopyLinkButton client:load />
</div>
