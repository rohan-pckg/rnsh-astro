---
import FloatingActions from "@/components/article/FloatingActions"

export interface Props {
  title: string
  date: Date
  readingTime: string
  backHref?: string
  updatedDate?: Date
  tags?: string[]
  author?: string
}

const {
  title,
  date,
  readingTime,
  backHref = "/writing",
  updatedDate,
  tags = [],
  author,
} = Astro.props

const published = date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
})

const updated = updatedDate?.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<header class="article-shell relative mb-8 sm:mb-10">
  <div class="mb-16 flex items-center justify-between sm:mb-20">
    <FloatingActions backHref={backHref} client:load />
  </div>

  <div>
    <h1 class="max-w-none text-lg leading-snug font-medium text-foreground">
      {title}
    </h1>

    <div
      class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-5 text-muted-foreground"
    >
      <time datetime={date.toISOString()}>{published}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
      {
        author && (
          <>
            <span aria-hidden="true">·</span>
            <span>{author}</span>
          </>
        )
      }
    </div>
  </div>

  {
    updated && (
      <p class="mt-3 text-xs text-muted-foreground">Updated {updated}</p>
    )
  }

  {
    tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
        {tags.map((tag) => (
          <li class="rounded-md bg-muted px-1.5 py-0.5 text-xs text-foreground">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</header>
