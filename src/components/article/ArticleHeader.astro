---
import BackButton from "@/components/article/BackButton"
import CopyLinkButton from "@/components/article/CopyLinkButton"

export interface Props {
  backHref?: string
}

const { backHref = "/writing" } = Astro.props
---

<div
  class="article-shell mb-16 flex min-h-10 items-center justify-between gap-3"
>
  <BackButton fallbackHref={backHref} client:load />
  <CopyLinkButton client:load />
</div>
