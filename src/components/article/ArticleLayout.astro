---
import ArticleContainer from "@/components/layout/ArticleContainer.astro"
import CodeBlock from "@/components/article/CodeBlock"

export interface Props {
  headings?: unknown[]
  title: string
  description: string
  date: Date
  category?: string
  readingTime?: number
}

const { title, description, date, readingTime } = Astro.props

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  })
---

<CodeBlock client:idle />

<ArticleContainer>
  <div class="article-wrapper">
    <slot name="nav" />

    <div class="page-content">
      <article class="max-w-full min-w-0">
      <h1 class="section-title">{title}</h1>
      <p class="body-text" style="margin-top: var(--gap-after-title)">{description}</p>
      <div class="article-meta" style="margin-top: var(--gap-after-description)">
        <time class="metadata" datetime={date.toISOString()}>
          {formatDate(date)}
        </time>
        {readingTime ? (
          <>
            <span class="metadata" style="margin: 0 0.4rem">•</span>
            <span class="metadata">{readingTime} min read</span>
          </>
        ) : null}
      </div>

      <div class="article-content" style="margin-top: var(--gap-after-meta)">
        <slot />
      </div>
      </article>
    </div>
  </div>
</ArticleContainer>

<style>
  article :global(.article-content) {
    color: var(--body);
    font-size: var(--type-body);
    line-height: 1.7;
  }

  article :global(.article-content h1),
  article :global(.article-content h2),
  article :global(.article-content h3),
  article :global(.article-content h4),
  article :global(.article-content h5),
  article :global(.article-content h6) {
    scroll-margin-top: 6rem;
    color: var(--heading);
    font-size: var(--type-body);
    font-weight: 500;
    line-height: 1.5;
    margin: 0;
  }

  article :global(.article-content h1) {
    font-size: var(--type-primary-heading);
    margin: 4.75rem 0 2rem;
  }

  article :global(.article-content h2) {
    margin: 3.5rem 0 1.5rem;
  }

  article :global(.article-content h3) {
    margin: 2.5rem 0 1rem;
  }

  article :global(.article-content h4) {
    margin: 2rem 0 0.75rem;
  }

  article :global(.article-content > :first-child) {
    margin-top: 0;
  }

  article :global(.article-content p) {
    margin: 1.25rem 0 0;
  }

  article :global(.article-content a) {
    color: var(--body);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
    transition: color 150ms ease-out;
  }

  article :global(.article-content a:hover),
  article :global(.article-content a:focus-visible) {
    color: var(--heading);
  }

  article :global(.article-content .sketchbook-afterthought) {
    margin-top: 4.75rem;
  }

  article :global(.article-content .sketchbook-afterthought a) {
    color: var(--inactive);
    font-size: var(--type-body);
  }

  article :global(.article-content .sketchbook-afterthought a:hover),
  article :global(.article-content .sketchbook-afterthought a:focus-visible) {
    color: var(--body);
  }

  article :global(.article-content ul),
  article :global(.article-content ol) {
    margin: 1.25rem 0;
    padding-left: 1.25rem;
  }

  article :global(.article-content ul) {
    list-style: disc;
  }

  article :global(.article-content ol) {
    list-style: decimal;
  }

  article :global(.article-content li) {
    margin-top: 0.4rem;
  }

  article :global(.article-content li::marker) {
    color: var(--inactive);
  }

  article :global(.article-content blockquote) {
    margin: 2.25rem 0;
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
    color: var(--heading);
    font-size: var(--type-body);
    line-height: 1.7;
  }

  article :global(.article-content p:has(img:only-child)) {
    margin-block: 3rem;
  }

  article :global(.article-content img) {
    display: block;
    width: 100%;
  }

  article :global(.article-content em:has(+ br)),
  article :global(.article-content img + em) {
    display: block;
    margin-top: 0.5rem;
    color: var(--inactive);
    font-size: var(--type-body);
    text-align: center;
  }

  article :global(.article-content code:not(pre code)) {
    background: #EFEBE3;
    color: var(--body);
    font-size: var(--type-body);
    font-weight: 400;
    padding: 2px 4px;
    border-radius: 4px;
  }

  article :global(.article-content pre code) {
    display: block;
    background: transparent;
    padding: 0;
    color: inherit;
    font: inherit;
    white-space: pre;
  }

  article :global(.article-content pre) {
    margin: 2rem 0;
    overflow-x: auto;
    padding: 1.25rem 0;
    background: #EFEBE3;
    border: 1px solid var(--border);
    color: var(--body);
    font-family: var(--font-mono);
    font-size: var(--type-body);
    line-height: 1.75;
    font-variant-numeric: tabular-nums;
  }

  article :global(.article-content pre .line) {
    display: inline-block;
    min-width: 100%;
    padding-right: 1rem;
    padding-left: 3.75rem;
  }

  article :global(.article-content pre .line::before) {
    content: var(--line-number);
    display: inline-block;
    width: 2rem;
    margin-left: -3rem;
    padding-right: 1rem;
    color: var(--inactive);
    text-align: right;
    user-select: none;
  }

  article :global(.article-content pre .highlighted),
  article :global(.article-content pre mark) {
    display: block;
    margin-right: 0;
    margin-left: 0;
    padding-right: 1rem;
    padding-left: 3.75rem;
    background: transparent;
    color: var(--heading);
  }

  article :global(.article-code-frame) {
    margin: 2rem 0;
    overflow: hidden;
  }

  article :global(.article-code-frame pre) {
    margin: 0;
  }

  article :global(.article-code-toolbar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
  }

  article :global(.article-code-badge),
  article :global(.article-code-copy) {
    color: var(--inactive);
    font-family: var(--font-mono);
    font-size: var(--type-body);
    line-height: 1.7;
    font-variant-numeric: tabular-nums;
  }

  article :global(.article-code-copy:hover),
  article :global(.article-code-copy:focus-visible) {
    color: var(--body);
  }

  article :global(.article-code-frame .astro-code),
  article :global(.article-code-frame .astro-code span) {
    color: var(--body) !important;
  }

  article :global(.article-content table) {
    width: 100%;
    font-size: var(--type-body);
  }

  article :global(.article-content th),
  article :global(.article-content td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
  }

  article :global(.article-content th) {
    color: var(--heading);
    font-weight: 500;
    text-align: left;
  }

  article :global(.article-content .footnotes) {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    font-size: var(--type-body);
  }
</style>
