---
export interface ProjectListItem {
  title: string
  description: string
  href: string
  external?: boolean
}

export interface Props {
  items: ProjectListItem[]
}

const { items } = Astro.props

/**
 * Derive the single external destination from the project's own href.
 * Live/demo URL -> "live", GitHub repository URL -> "github".
 * Relative (internal) hrefs get no metadata so detail navigation, if ever
 * added, keeps working without interference.
 */
function destination(href: string): "live" | "github" | null {
  let host: string
  try {
    host = new URL(href).hostname.toLowerCase()
  } catch {
    return null
  }
  if (!host) return null
  if (host === "github.com" || host.endsWith(".github.com")) return "github"
  return "live"
}
---

<ul class="list">
  {
    items.map((project) => {
      const dest = destination(project.href)
      return (
        <li>
          {/* Name, then where it lives, then what it is — the same order the
              design's own project index uses, and the same three-tier
              hierarchy: accent for the name, muted for the status, and
              prose-weight grey for the description. */}
          <div class="list-item">
            <a
              href={project.href}
              class="list-title"
              target={project.external ? "_blank" : undefined}
              rel={project.external ? "noopener noreferrer" : undefined}
              data-sound="navigate"
            >
              {project.title}
            </a>
            
            <p class="body-text">{project.description}</p>
          </div>
        </li>
      )
    })
  }
</ul>