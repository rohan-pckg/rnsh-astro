---
export interface ThoughtListItem {
  title: string
  href: string
  date: Date
}

export interface Props {
  items: ThoughtListItem[]
}

const { items } = Astro.props

/**
 * `MM/YY`, the same short stamp the designs index uses.
 */
const formatMonthYear = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "2-digit", year: "2-digit" })
---

<ul class="entry-list">
  {
    items.map((post) => (
      <li>
        <article class="entry">
          <a href={post.href} class="entry-title" data-sound="navigate">
            {post.title}
          </a>
          <time class="date" datetime={post.date.toISOString()}>
            {formatMonthYear(post.date)}
          </time>
        </article>
      </li>
    ))
  }
</ul>