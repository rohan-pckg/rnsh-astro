---
export interface Props {
  title: string
  href: string
  date: string
  active?: boolean
  category?: string
}

const { title, href, date, active = false } = Astro.props
---

<a
  href={href}
  aria-current={active ? "page" : undefined}
  class="writing-item"
  data-sound="navigate"
>
  <span class="writing-title">
    {title}
  </span>

  <span class="writing-divider" aria-hidden="true"></span>

  <time class="writing-date">{date}</time>
</a>
