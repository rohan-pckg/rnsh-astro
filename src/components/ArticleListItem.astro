---
export interface Props {
  title: string
  href: string
  date: string
}

const { title, href, date } = Astro.props
---

<a href={href} class="writing-item" data-sound="navigate">
  <span class="writing-title">
    {title}
  </span>

  <span class="writing-divider" aria-hidden="true"></span>

  <time class="writing-date">{date}</time>
</a>
