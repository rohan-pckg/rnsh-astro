---
export interface Props {
  title: string
  href: string
  date: string
  category: string
}

const { title, href, date, category } = Astro.props
---

<a
  href={href}
  class="group -mx-3 block rounded-lg px-3 py-4 transition-colors duration-200 hover:bg-muted/40 focus-visible:bg-muted/40 focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
>
  <h2
    class="page-title transition-colors duration-200 group-hover:text-foreground"
  >
    {title}
  </h2>

  <div class="metadata mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
    <time>{date}</time>
    <span aria-hidden="true">·</span>
    <span>{category}</span>
  </div>
</a>
