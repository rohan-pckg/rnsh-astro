---
import { inkIcon } from "@/data/ink-icons"
import {
  homeContacts,
  normalizeHref,
  isExternalHref,
} from "@/data/home-contact"

/**
 * The drawer: ONE native <dialog> holding two independent panels, one shared
 * implementation for every section with nested pages.
 *  - hubs (far right): Contact, About, Work, Notes, Writing; one visible at a time;
 *  - detail (left column): the item opened from a hub (a post, a design
 *    write-up, the full About content), filled on demand from
 *    /posts/<slug>.json. It docks just left of the hub, or takes the far-right
 *    slot when no hub is open.
 * Desktop: side by side (both can be open). Phones: stacked bottom sheets.
 * Behaviour lives in ./drawer.ts. All CSS is scoped under `.story-drawer`.
 */
interface Post {
  id: string
  title: string
  date: string
  summary: string
  kind: "note" | "blog"
  hub: "notes" | "writing"
}
interface WorkItem {
  type: "code" | "design"
  title: string
  summary: string
  /** Mono tag on the right: the stack for code, the year for design. */
  tag?: string
  href: string
  /** Design items: the write-up's slug (opens in the left column). */
  slug?: string
  /** Design items: preview image URL. */
  image?: string
}
interface AboutLink {
  label: string
  value: string
  href?: string
  post?: string
}
interface Props {
  posts: Post[]
  /** Introduces the Writing list. */
  writingIntro?: string
  about: { paragraphs: string[]; links: AboutLink[] }
  work: WorkItem[]
}
const { posts, writingIntro, about, work } = Astro.props

// Normalize every href at render time; external-ness comes from the URL itself.
const normalize = <T extends { href: string }>(rows: T[]) =>
  rows.map((c) => {
    const href = normalizeHref(c.href)
    return { ...c, href, external: isExternalHref(href) }
  })
const contactRows = normalize(homeContacts)
const codeItems = normalize(work.filter((w) => w.type === "code"))
const designItems = work.filter((w) => w.type === "design" && w.slug)

// Everything the left column can show, and which hub owns it.
const items = [
  ...posts.map((p) => ({
    id: p.id,
    title: p.title,
    date: p.date,
    hub: p.hub,
    kind: p.kind,
  })),
  ...designItems.map((d) => ({
    id: d.slug!,
    title: d.title,
    date: d.tag ?? "",
    hub: "work",
    kind: "design",
  })),
  { id: "full", title: "More about me", date: "About", hub: "about", kind: "about" },
]

const btn =
  "font-geist-mono cursor-pointer text-[12px] leading-normal font-normal text-[rgb(var(--h-ink))] uppercase underline underline-offset-1 opacity-40 transition-opacity hover:opacity-80"
const label =
  "font-geist-mono text-[12px] leading-normal uppercase opacity-40"
const subtitle =
  "font-geist mt-2 text-[14px] leading-normal font-medium opacity-80"
---

<dialog
  class="story-drawer"
  tabindex="-1"
  aria-modal="true"
  aria-label="Details"
  data-items={JSON.stringify(items)}
>
  <div class="sr-only" aria-live="polite" data-sd-live></div>
  <div class="sd-scrim" data-sd-scrim></div>

  {/* DETAIL: the open item (one panel, filled on demand). */}
  <div class="sd-panel sd-detail" data-sd-side="detail" role="region" aria-label="Details" tabindex="-1" hidden>
    <article class="sd-post">
      <header class="sd-head" data-sd-drag>
        <span class="sd-handle" aria-hidden="true" />
        <div class="sd-head-text">
          <time class={label} data-sd-date></time>
          <span class="sd-head-title" data-sd-head-title aria-hidden="true" hidden></span>
        </div>
        <div class="sd-actions">
            <button
              type="button"
              class="sd-icon-btn sd-copy"
              data-sd-copy
              data-fluid-item
              data-fluid-pad="3 3"
              aria-label="Copy link"
            >
              <span class="sd-ic" data-ic="link"><Fragment set:html={inkIcon("link", 14)} /></span>
              <span class="sd-ic" data-ic="done" hidden><Fragment set:html={inkIcon("check", 14)} /></span>
            </button>
            <button
              type="button"
              class="sd-icon-btn sd-expand"
              data-sd-expand
              data-fluid-item
              data-fluid-pad="3 3"
              aria-pressed="false"
              aria-label="Expand to full screen"
            >
              <Fragment set:html={inkIcon("expand", 14)} />
              <Fragment set:html={inkIcon("collapse", 14)} />
            </button>
            <button
              type="button"
              class="sd-icon-btn"
              data-sd-close
              data-cuelume-close
              data-fluid-item
              data-fluid-pad="3 3"
              aria-label="Close"
            >
              <Fragment set:html={inkIcon("close", 14)} />
            </button>
          </div>
      </header>
      <div class="sd-scroll" tabindex="-1">
        <div data-sd-content></div>
      </div>
    </article>
  </div>

  {/* HUBS. One visible at a time. */}
  <div class="sd-panel sd-hubs" data-sd-side="hub" role="region" aria-label="Details" tabindex="-1" hidden>
    {/* CONTACT (?page=contact) */}
    <article class="sd-post" data-sd-hub="contact" hidden>
      <header class="sd-head" data-sd-drag>
        <span class="sd-handle" aria-hidden="true" />
        <span id="sd-title-contact" class={label} data-sd-label>Contact</span>
        <div class="sd-actions">
            <button
              type="button"
              class="sd-icon-btn sd-expand"
              data-sd-expand
              data-fluid-item
              data-fluid-pad="3 3"
              aria-pressed="false"
              aria-label="Expand to full screen"
            >
              <Fragment set:html={inkIcon("expand", 14)} />
              <Fragment set:html={inkIcon("collapse", 14)} />
            </button>
            <button
              type="button"
              class="sd-icon-btn"
              data-sd-close
              data-cuelume-close
              data-fluid-item
              data-fluid-pad="3 3"
              aria-label="Close contact"
            >
              <Fragment set:html={inkIcon("close", 14)} />
            </button>
          </div>
      </header>

      <div class="sd-scroll" tabindex="-1">
        <ul class="sd-contacts">
          {
            contactRows.map((c) => (
              <li>
                <a
                  class="sd-row"
                  href={c.href}
                  target={c.external ? "_blank" : undefined}
                  rel={c.external ? "noopener noreferrer" : undefined}
                  data-cuelume-tap
                  data-fluid-item
                >
                  <span class="sd-row-label">{c.label}</span>
                  <span class="sd-row-value">{c.value}</span>
                  {c.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    {/* ABOUT (?page=about); the full content is the left column's "full" */}
    <article class="sd-post" data-sd-hub="about" hidden>
      <header class="sd-head" data-sd-drag>
        <span class="sd-handle" aria-hidden="true" />
        <span id="sd-title-about" class={label} data-sd-label>About</span>
        <div class="sd-actions">
            <button
              type="button"
              class="sd-icon-btn sd-expand"
              data-sd-expand
              data-fluid-item
              data-fluid-pad="3 3"
              aria-pressed="false"
              aria-label="Expand to full screen"
            >
              <Fragment set:html={inkIcon("expand", 14)} />
              <Fragment set:html={inkIcon("collapse", 14)} />
            </button>
            <button
              type="button"
              class="sd-icon-btn"
              data-sd-close
              data-cuelume-close
              data-fluid-item
              data-fluid-pad="3 3"
              aria-label="Close about"
            >
              <Fragment set:html={inkIcon("close", 14)} />
            </button>
          </div>
      </header>
      <div class="sd-scroll" tabindex="-1">
        <h2 class={subtitle}>More about me</h2>
        <div class="sd-prose">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <ul class="sd-contacts">
          {
            about.links.map((c) => {
              const href = c.href ? normalizeHref(c.href) : `/?page=about&post=${c.post}`
              const external = !!c.href && isExternalHref(href)
              return (
                <li>
                  <a
                    class="sd-row"
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    data-post={c.post}
                    data-cuelume-tap
                    data-fluid-item
                  >
                    <span class="sd-row-label">{c.label}</span>
                    <span class="sd-row-value">{c.value}</span>
                    {external && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                </li>
              )
            })
          }
        </ul>
      </div>
    </article>

    {/* NOTES (?page=notes[&post=<slug>]): short philosophical notes */}
    <article class="sd-post" data-sd-hub="notes" hidden>
      <header class="sd-head" data-sd-drag>
        <span class="sd-handle" aria-hidden="true" />
        <span id="sd-title-notes" class={label} data-sd-label>Notes</span>
        <div class="sd-actions">
            <button
              type="button"
              class="sd-icon-btn sd-expand"
              data-sd-expand
              data-fluid-item
              data-fluid-pad="3 3"
              aria-pressed="false"
              aria-label="Expand to full screen"
            >
              <Fragment set:html={inkIcon("expand", 14)} />
              <Fragment set:html={inkIcon("collapse", 14)} />
            </button>
            <button
              type="button"
              class="sd-icon-btn"
              data-sd-close
              data-cuelume-close
              data-fluid-item
              data-fluid-pad="3 3"
              aria-label="Close notes"
            >
              <Fragment set:html={inkIcon("close", 14)} />
            </button>
          </div>
      </header>
      <div class="sd-scroll" tabindex="-1">
      
        <ul class="sd-contacts">
          {
            posts.filter((p) => p.hub === "notes").map((p) => (
              <li>
                <a
                  class="sd-row sd-work-row"
                  href={`/?page=notes&post=${p.id}`}
                  data-post={p.id}
                  data-cuelume-select
                  data-fluid-item
                >
                  <span class="sd-work-text">
                    <span class="sd-row-title">{p.title}</span>
                    <span class="sd-summary">{p.summary}</span>
                  </span>
                  <span class="sd-row-meta">{p.date}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    {/* WRITING (?page=writing[&post=<slug>]): the blog posts */}
    <article class="sd-post" data-sd-hub="writing" hidden>
      <header class="sd-head" data-sd-drag>
        <span class="sd-handle" aria-hidden="true" />
        <span id="sd-title-writing" class={label} data-sd-label>Writing</span>
        <div class="sd-actions">
            <button
              type="button"
              class="sd-icon-btn sd-expand"
              data-sd-expand
              data-fluid-item
              data-fluid-pad="3 3"
              aria-pressed="false"
              aria-label="Expand to full screen"
            >
              <Fragment set:html={inkIcon("expand", 14)} />
              <Fragment set:html={inkIcon("collapse", 14)} />
            </button>
            <button
              type="button"
              class="sd-icon-btn"
              data-sd-close
              data-cuelume-close
              data-fluid-item
              data-fluid-pad="3 3"
              aria-label="Close writing"
            >
              <Fragment set:html={inkIcon("close", 14)} />
            </button>
          </div>
      </header>
      <div class="sd-scroll" tabindex="-1">
        {writingIntro && <p class="sd-prose">{writingIntro}</p>}
        <ul class="sd-contacts">
          {
            posts.filter((p) => p.hub === "writing").map((p) => (
              <li>
                <a
                  class="sd-row sd-work-row"
                  href={`/?page=writing&post=${p.id}`}
                  data-post={p.id}
                  data-cuelume-select
                  data-fluid-item
                >
                  <span class="sd-work-text">
                    <span class="sd-row-title">{p.title}</span>
                    <span class="sd-summary">{p.summary}</span>
                  </span>
                  <span class="sd-row-meta">{p.date}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    {/* ALL OF MY WORK (?page=work[&view=design]) */}
    <article class="sd-post" data-sd-hub="work" hidden>
      <header class="sd-head" data-sd-drag>
        <span class="sd-handle" aria-hidden="true" />
        <span id="sd-title-work" class={label} data-sd-label>Work</span>
        <div class="sd-actions">
            <button
              type="button"
              class="sd-icon-btn sd-expand"
              data-sd-expand
              data-fluid-item
              data-fluid-pad="3 3"
              aria-pressed="false"
              aria-label="Expand to full screen"
            >
              <Fragment set:html={inkIcon("expand", 14)} />
              <Fragment set:html={inkIcon("collapse", 14)} />
            </button>
            <button
              type="button"
              class="sd-icon-btn"
              data-sd-close
              data-cuelume-close
              data-fluid-item
              data-fluid-pad="3 3"
              aria-label="Close work"
            >
              <Fragment set:html={inkIcon("close", 14)} />
            </button>
          </div>
      </header>
      <div class="sd-scroll" tabindex="-1">


        <div class="sd-seg" role="tablist" aria-label="Type of work" data-active="code" data-sd-tabs>
          <span class="sd-seg-ind" aria-hidden="true"></span>
          <button type="button" role="tab" id="sd-tab-code" class="sd-seg-tab" aria-selected="true" aria-controls="sd-view-code" tabindex="0" data-sd-tab="code">
            Code<span class="sd-seg-n" style="margin-left:7px">{codeItems.length}</span>
          </button>
          <button type="button" role="tab" id="sd-tab-design" class="sd-seg-tab" aria-selected="false" aria-controls="sd-view-design" tabindex="-1" data-sd-tab="design">
            Design<span class="sd-seg-n" style="margin-left:7px">{designItems.length}</span>
          </button>
        </div>

        <div class="sd-views" data-sd-views>
          <div role="tabpanel" id="sd-view-code" aria-labelledby="sd-tab-code" data-sd-view="code">
            <ul class="sd-contacts">
              {
                codeItems.map((w) => (
                  <li>
                    <a
                      class="sd-row sd-work-row"
                      href={w.href}
                      target={w.external ? "_blank" : undefined}
                      rel={w.external ? "noopener noreferrer" : undefined}
                      data-cuelume-tap
                      data-fluid-item
                    >
                      <span class="sd-work-text">
                        <span class="sd-row-title">{w.title}</span>
                        <span class="sd-summary">{w.summary}</span>
                      </span>
                      {w.tag && <span class="sd-row-meta">{w.tag}</span>}
                      {w.external && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div role="tabpanel" id="sd-view-design" aria-labelledby="sd-tab-design" data-sd-view="design" hidden>
            <ul class="sd-contacts sd-designs">
              {
                designItems.map((w) => (
                  <li>
                    <a
                      class="sd-design"
                      href={w.href}
                      data-post={w.slug}
                      data-cuelume-select
                      data-fluid-item
                    >
                      {w.image ? (
                        <img
                          class="sd-design-img"
                          src={w.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        // TODO: add a `thumbnail` to this design's frontmatter.
                        <span class="sd-design-img" aria-hidden="true" />
                      )}
                      <span class="sd-design-head">
                        <span class="sd-row-title">{w.title}</span>
                        {w.tag && <span class="sd-row-meta">{w.tag}</span>}
                      </span>
                      <span class="sd-design-desc">{w.summary}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </article>
  </div>
</dialog>

<style is:global>
  .story-drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgb(var(--h-ink));
    overflow: hidden;
  }
  .story-drawer:focus,
  .story-drawer:focus-visible {
    outline: none;
  }
  .story-drawer:not([open]) {
    display: none;
  }
  .story-drawer::backdrop {
    background: transparent;
  }
  .sd-scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
  }
  .sd-panel {
    position: absolute;
    top: 16px;
    bottom: 16px;
    width: min(520px, 90vw);
    max-width: calc(100% - 32px);
    overflow: hidden;
    border-radius: 4px;
    transition:
      width 460ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms ease;
    background: var(--h-paper);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(0, 0, 0, 0.04);
    will-change: transform;
  }
  .sd-panel:focus,
  .sd-panel:focus-visible {
    outline: none;
  }
  /* Two docked panels share the viewport: the list (right) stays compact and
     the routed item (left) gets the larger share. From 1280px up they are
     equal (see the media query below). */
  .sd-hubs {
    right: 16px;
    width: clamp(300px, 36vw, 440px);
  }
  /* The detail panel is anchored to the far-right slot like the hub; the
     script translates it left by the hub's width + 16px while a hub is open.
     Width: up to 640px, and never wider than the space left beside the hub,
     so it is always the larger of the two. */
  .sd-detail {
    right: 16px;
    width: min(640px, calc(100vw - 48px - clamp(300px, 36vw, 440px)));
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      width 460ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms ease;
  }
  /* Full screen: the panel grows leftwards to fill the page (keeping the
     16px gutter) while the page behind it blurs. Content stays a readable
     column. */
  .sd-panel.is-full {
    z-index: 3 !important;
    width: calc(100vw - 32px);
    max-width: none;
  }
  .sd-panel.is-full .sd-scroll {
    padding-inline: max(16px, calc((100% - 640px) / 2));
  }
  .sd-scrim {
    transition:
      background-color 460ms ease,
      backdrop-filter 460ms ease;
  }
  .story-drawer[data-full] .sd-scrim {
    background: rgba(0, 0, 0, 0.28);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .story-drawer[data-full] .sd-panel:not(.is-full) {
    opacity: 0;
    pointer-events: none;
  }
  /* Wide screens have room for two equal columns. */
  @media (min-width: 1280px) {
    .sd-hubs,
    .sd-detail {
      width: 520px;
    }
  }
  .sd-panel[hidden] {
    display: none;
  }
  .sd-post {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .sd-post[hidden] {
    display: none;
  }
  .sd-head {
    position: relative;
    z-index: 1;
    display: flex;
    flex: none;
    align-items: flex-start;
    justify-content: space-between;
    padding: 16px;
  }
  .sd-handle {
    display: none;
  }
  /* Header icon buttons: 14px ink-doodle glyphs with a 28px hit area, pulled
     into the header's 16px padding so the glyph sits on the grid. */
  .sd-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: -7px -7px 0 0;
  }
  .sd-icon-btn {
    padding: 7px;
    border: 0;
    background: none;
    color: rgb(var(--h-ink));
    line-height: 0;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) {
    .sd-icon-btn:hover {
      opacity: 0.9;
    }
  }
  /* Detail header: the date, which gives way to the item's title once the
     title has scrolled out of view (script toggles `hidden`, one at a time). */
  .sd-head-text {
    flex: 1;
    min-width: 0;
    height: 18px;
    margin-right: 12px;
  }
  .sd-head-text [hidden] {
    display: none;
  }
  .sd-head-title {
    display: block;
    overflow: hidden;
    font-family: "Geist:Medium", sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: rgb(var(--h-ink) / 0.85);
    pointer-events: none;
  }
  .sd-ic {
    display: block;
    line-height: 0;
  }
  .sd-ic[hidden] {
    display: none;
  }
  .sd-expand .i-collapse,
  .sd-expand[aria-pressed="true"] .i-expand {
    display: none;
  }
  .sd-expand[aria-pressed="true"] .i-collapse {
    display: block;
  }
  .sd-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 16px 32px;
  }
  .sd-art {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
  }
  .sd-prose {
    margin-top: 12px;
    font-family: "Geist:Medium", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.625;
    color: rgb(var(--h-ink) / 0.6);
  }
  .sd-prose > * + * {
    margin-top: 16px;
  }
  /* Shared by the Work, Notes and Design rows. */
  .sd-row-title {
    min-width: 0;
    font-family: "Geist:Medium", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    opacity: 0.8;
  }
  .sd-row-meta {
    flex: none;
    font-family: "Geist Mono:Regular", monospace;
    font-size: 12px;
    line-height: 1.5;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.4;
  }
  .sd-contacts {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(var(--h-ink) / 0.06);
  }
  .sd-contacts li {
    border-bottom: 1px solid rgb(var(--h-ink) / 0.06);
  }
  .sd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    padding: 0 4px;
    color: rgb(var(--h-ink));
    text-decoration: none;
  }
  .sd-row-label {
    flex: none;
    font-family: "Geist Mono:Regular", monospace;
    font-size: 12px;
    line-height: 1.5;
    text-transform: uppercase;
    opacity: 0.4;
  }
  .sd-row-value {
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: right;
    font-family: "Geist:Medium", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    opacity: 0.8;
  }
