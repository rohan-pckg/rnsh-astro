---
import { formatDate } from "@/lib/format"

export interface IndexListItem {
  title: string
  href: string
  date?: Date
  description?: string
  thumbnail?: string
}

export interface Props {
  items: IndexListItem[]
  emptyLabel?: string
}

const { items, emptyLabel = "Nothing here yet." } = Astro.props
---

{
  items.length > 0 ? (
    <ul class="hover-list space-y-9">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class="hover-item group grid gap-4"
            data-sound="navigate"
          >
            {item.thumbnail && (
              <div>
                <img
                  src={item.thumbnail}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="aspect-video w-full object-cover"
                />
              </div>
            )}

            <div class="flex items-baseline justify-between gap-4">
              <span class="section-title">{item.title}</span>
              {item.date && (
                <time
                  datetime={item.date.toISOString()}
                  class="metadata shrink-0"
                >
                  {formatDate(item.date)}
                </time>
              )}
            </div>

            {item.description && <p class="body-text">{item.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="body-text">{emptyLabel}</p>
  )
}
