---
interface Props {
  variant?: "entry" | "avatar"
}

const { variant = "entry" } = Astro.props
const isAvatar = variant === "avatar"
const linkClass = isAvatar ? "flower-doodle__avatar-link" : "flower-doodle"
const svgClass = isAvatar ? "flower-doodle__avatar" : "flower-doodle__svg"
const viewBox = isAvatar ? "108 38 96 138" : "0 0 230 190"
---

<div class:list={["flower-doodle__shell", { "is-avatar": isAvatar }]}>
  <a
    id="flower-doodle"
    href="/sketchbook"
    class={linkClass}
    aria-label="Open Sketchbook"
  >
    <svg viewBox={viewBox} fill="none" aria-hidden="true" class={svgClass}>
      <g class="flower-doodle__art">
        <g class="flower-doodle__petals">
          <path
            d="M158.2 80.6c-19.6-18.4-33.2-17.6-37.4-8.6-4.6 9.9 5.3 22.4 31.5 25.6-20.3 8.1-26.7 22.9-17.7 31.4 8.9 8.4 27.4 1.5 30-22.2 8.3 23.8 27.9 28.7 36.4 18.2 8.1-10.1.7-25-19.8-31.4 22-3.6 31.4-18.5 24.8-28.8-6.4-9.9-25.3-6.7-40.4 12.9 6.2-25.5-4.5-39.1-16.1-35.5-10 3-14 18.2 8.7 38.4Z"
            stroke="currentColor"
            stroke-width="7.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M163.6 82.8c7.8.4 12.2 5.7 10.8 12.6-1.3 6.5-8.3 10.5-15.9 8.2-7.2-2.2-9.2-9.6-6.4-15.2 2.1-4.3 6.5-6 11.5-5.6Z"
            stroke="currentColor"
            stroke-width="7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </g>

        <path
          d="M163.2 103.9c-1.2 12.8-3.3 24.2-2 34.4 1.1 8.6 4.6 17.2 7 24 2.4 6.7 2.9 11.6 1 15.7"
          stroke="currentColor"
          stroke-width="7.2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </g>
    </svg>
  </a>
</div>

<script>
  import { playSound } from "@/lib/sound"

  const doodle = document.getElementById("flower-doodle")
  let opening = false

  function openSketchbook() {
    if (!doodle || opening) return

    opening = true
    playSound("draw")
    window.setTimeout(() => {
      window.location.href = "/sketchbook"
    }, 210)
  }

  doodle?.addEventListener("click", (event) => {
    event.preventDefault()
    openSketchbook()
  })

  doodle?.addEventListener("keydown", (event) => {
    if (event.key !== " ") return
    event.preventDefault()
    openSketchbook()
  })
</script>

<style>
  .flower-doodle__shell {
    display: contents;
  }

  .flower-doodle__shell.is-avatar {
    position: relative;
    display: block;
    width: 2.95rem;
    height: 2.95rem;
    margin-top: 1rem;
    overflow: visible;
  }

  .flower-doodle {
    position: absolute;
    top: 0.75rem;
    right: 0.125rem;
    z-index: 1;
    display: inline-flex;
    width: clamp(4.5rem, 21vw, 5.25rem);
    margin: 0;
    flex-direction: column;
    align-items: center;
    color: color-mix(in oklch, var(--foreground) 62%, transparent);
    opacity: 0.72;
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .flower-doodle__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transform: translateX(-18%);
  }

  .flower-doodle__avatar-link {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    color: color-mix(in oklch, var(--foreground) 62%, transparent);
    cursor: pointer;
    overflow: visible;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .flower-doodle__avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    overflow: visible;
  }

  .flower-doodle__art {
    transform-origin: 163px 126px;
    transition: transform 180ms ease;
  }

  .flower-doodle__petals {
    transform-origin: 163px 92px;
  }

  .flower-doodle:hover,
  .flower-doodle:focus-visible,
  .flower-doodle__avatar-link:hover,
  .flower-doodle__avatar-link:focus-visible {
    color: var(--foreground);
    opacity: 0.92;
    outline: none;
  }

  .flower-doodle:hover .flower-doodle__art,
  .flower-doodle:focus-visible .flower-doodle__art,
  .flower-doodle__avatar-link:hover .flower-doodle__art,
  .flower-doodle__avatar-link:focus-visible .flower-doodle__art {
    transform: rotate(2deg) scale(1.04);
    animation: none;
  }

  .flower-doodle:focus-visible,
  .flower-doodle__avatar-link:focus-visible {
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 1px var(--ring);
  }

  @media (min-width: 640px) {
    .flower-doodle {
      width: min(6.25rem, 26vw);
      color: color-mix(in oklch, var(--foreground) 70%, transparent);
      opacity: 0.7;
    }

    .flower-doodle__svg {
      transform: none;
    }

    .flower-doodle__shell.is-avatar {
      width: 3rem;
      height: 3rem;
      margin-top: 0.75rem;
    }

    .flower-doodle__avatar-link {
      color: color-mix(in oklch, var(--foreground) 70%, transparent);
    }
  }

  @media (min-width: 768px) {
    .flower-doodle {
      top: 1.25rem;
      right: 0;
      width: clamp(5.5rem, 13vw, 6.1rem);
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .flower-doodle {
      top: 1rem;
      right: 0.25rem;
      width: 6.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flower-doodle,
    .flower-doodle__avatar-link,
    .flower-doodle *,
    .flower-doodle__avatar-link * {
      animation: none;
      transition: color 150ms ease;
    }
  }
</style>
