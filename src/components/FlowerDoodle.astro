      </g>
    </g>
  </svg>
</a>

<script>
  import { playSound } from "@/lib/sound"

  const doodle = document.getElementById("flower-doodle")
  let opening = false

  function openSketchbook() {
    if (!doodle || opening) return

    opening = true
    playSound("draw")
    doodle.classList.add("is-blooming")
    window.setTimeout(() => {
      window.location.href = "/sketchbook"
    }, 210)
  }

  doodle?.addEventListener("click", (event) => {
    event.preventDefault()
    openSketchbook()
  })

  doodle?.addEventListener("keydown", (event) => {
    if (event.key !== " ") return
    event.preventDefault()
    openSketchbook()
  })
</script>

<style>
  .flower-doodle {
    position: absolute;
    top: 0.75rem;
    right: 0.125rem;
    z-index: 1;
    display: inline-flex;
    width: clamp(4.5rem, 21vw, 5.25rem);
    margin: 0;
    flex-direction: column;
    align-items: center;
    color: color-mix(in oklch, var(--foreground) 62%, transparent);
    opacity: 0.72;
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .flower-doodle__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transform: translateX(-18%);
  }

  .flower-doodle__art {
    transform-origin: 160px 164px;
    animation: flower-breeze 320ms ease-out 1.25s 1 both;
    transition: transform 180ms ease;
  }

  .flower-doodle__petals {
    transform-origin: 162px 83px;
  }

  .flower-doodle:hover,
  .flower-doodle:focus-visible {
    color: var(--foreground);
    opacity: 0.92;
    outline: none;
  }

  .flower-doodle:hover .flower-doodle__art,
  .flower-doodle:focus-visible .flower-doodle__art {
    transform: rotate(2deg) scale(1.04);
    animation: none;
  }

  .flower-doodle:focus-visible {
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 1px var(--ring);
  }

  .flower-doodle.is-blooming .flower-doodle__petals {
    animation: flower-bloom 210ms ease-out both;
  }

  @keyframes flower-breeze {
    0% {
      transform: rotate(0deg);
    }
    45% {
      transform: rotate(2.4deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  @keyframes flower-bloom {
    0% {
      transform: scale(1);
    }
    58% {
      transform: scale(1.13) rotate(1.5deg);
    }
    100% {
      transform: scale(1.04) rotate(0deg);
    }
  }

  @media (min-width: 640px) {
    .flower-doodle {
      width: min(6.25rem, 26vw);
      color: color-mix(in oklch, var(--foreground) 70%, transparent);
      opacity: 0.7;
    }

    .flower-doodle__svg {
      transform: none;
    }
  }

  @media (min-width: 768px) {
    .flower-doodle {
      top: 1.25rem;
      right: 0;
      width: clamp(5.5rem, 13vw, 6.1rem);
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .flower-doodle {
      top: 1rem;
      right: 0.25rem;
      width: 6.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flower-doodle,
    .flower-doodle *,
    .flower-doodle.is-blooming .flower-doodle__petals {
      animation: none;
      transition: color 150ms ease;
    }
  }
</style>
