---
interface Props {
  variant?: "entry" | "avatar"
}

const { variant = "entry" } = Astro.props
const isAvatar = variant === "avatar"
const linkClass = isAvatar ? "flower-doodle__avatar-link" : "flower-doodle"
const svgClass = isAvatar ? "flower-doodle__avatar" : "flower-doodle__svg"
const viewBox = isAvatar ? "108 38 96 138" : "0 0 230 190"
---

<div class:list={["flower-doodle__shell", { "is-avatar": isAvatar }]}>
  {
    isAvatar ? (
      <div class="flower-doodle__annotation" aria-hidden="true">
        <span>Open Sketchbook</span>
        <svg
          viewBox="0 0 54 24"
          fill="none"
          class="flower-doodle__annotation-arrow"
        >
          <path
            d="M49 4.2C38.1 5.4 28 9.4 19.5 16"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M20 15.8c3.7-.3 6.6.4 8.7 2"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M20 15.8c2.1-2.9 3.5-5.5 4.1-7.7"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    ) : null
  }

  <a
    id="flower-doodle"
    href="/sketchbook"
    class={linkClass}
    aria-label="Open Sketchbook"
  >
    <svg viewBox={viewBox} fill="none" aria-hidden="true" class={svgClass}>
      <g class="flower-doodle__art">
        <g class="flower-doodle__petals">
          <path
            d="M159.7 76.1c-15.4-17.1-13.7-31.2-3.6-33.9 10.4-2.8 17 9.4 10.8 28.5 14.7-13.8 28.8-14.5 33.1-5.7 4.6 9.5-7 18.1-27.2 17.4 18.4 8.7 24.5 21.3 16.8 28.5-7.4 6.9-20.4-.1-26-18.8-3.4 19.4-13.5 29.2-22.5 23.8-8.7-5.3-5.6-19.4 11.2-30.1-20.2 2.3-31.7-6.1-28.9-15.8 2.8-9.6 16.7-10.9 36.3 6.1Z"
            stroke="currentColor"
            stroke-width="2.15"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M162.7 79.9c2.9-.7 5.2.4 5.8 2.8.6 2.4-1.3 4.8-4.2 5.5-3 .7-5.5-.5-6.1-2.9-.6-2.3 1.5-4.7 4.5-5.4Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </g>

        <path
          d="M162.5 92.8c-3 21.5-4.2 39.3-2 63.5"
          stroke="currentColor"
          stroke-width="2.15"
          stroke-linecap="round"></path>
        <path
          d="M160.5 125.6c-13.8-11.4-25.1-13.9-35.4-6.3 11.1 7.3 22.6 7 35.4 6.3Z"
          stroke="currentColor"
          stroke-width="1.95"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M160.8 136.2c12.9-14 25.3-18.2 36-10.4-10.4 8.4-22.3 9.6-36 10.4Z"
          stroke="currentColor"
          stroke-width="1.95"
          stroke-linecap="round"
          stroke-linejoin="round"></path>

        <g class="flower-doodle__ground" opacity="0.9">
          <path
            d="M111 164c22.6 5.1 59.5 5.4 87.5 1.4"
            stroke="currentColor"
            stroke-width="1.65"
            stroke-linecap="round"></path>
          <path
            d="M121 173c14.3-3.5 25.9-3.7 39.4-.5 14.7 3.5 28.3 2.2 41.1-2.2"
            stroke="currentColor"
            stroke-width="1.35"
            stroke-linecap="round"></path>
          <path
            d="M131.3 161.3c-1.8-5.8-1.2-10.1 1.7-13"
            stroke="currentColor"
            stroke-width="1.45"
            stroke-linecap="round"></path>
          <path
            d="M142.3 163c.3-6.7 2.7-10.7 7.2-12"
            stroke="currentColor"
            stroke-width="1.45"
            stroke-linecap="round"></path>
          <path
            d="M181.6 162.2c2.7-6 6-9.5 10.2-10.5"
            stroke="currentColor"
            stroke-width="1.45"
            stroke-linecap="round"></path>
          <path
            d="M194.5 162.8c-1.1-5.2-.3-9 2.4-11.4"
            stroke="currentColor"
            stroke-width="1.45"
            stroke-linecap="round"></path>
        </g>
      </g>
    </svg>
  </a>
</div>

<script>
  import { playSound } from "@/lib/sound"

  const doodle = document.getElementById("flower-doodle")
  let opening = false

  function openSketchbook() {
    if (!doodle || opening) return

    opening = true
    playSound("draw")
    doodle.classList.add("is-blooming")
    window.setTimeout(() => {
      window.location.href = "/sketchbook"
    }, 210)
  }

  doodle?.addEventListener("click", (event) => {
    event.preventDefault()
    openSketchbook()
  })

  doodle?.addEventListener("keydown", (event) => {
    if (event.key !== " ") return
    event.preventDefault()
    openSketchbook()
  })
</script>

<style>
  .flower-doodle__shell {
    display: contents;
  }

  .flower-doodle__shell.is-avatar {
    position: relative;
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: 1rem;
  }

  .flower-doodle {
    position: absolute;
    top: 0.75rem;
    right: 0.125rem;
    z-index: 1;
    display: inline-flex;
    width: clamp(4.5rem, 21vw, 5.25rem);
    margin: 0;
    flex-direction: column;
    align-items: center;
    color: color-mix(in oklch, var(--foreground) 62%, transparent);
    opacity: 0.72;
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .flower-doodle__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transform: translateX(-18%);
  }

  .flower-doodle__avatar-link {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    color: color-mix(in oklch, var(--foreground) 62%, transparent);
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .flower-doodle__avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .flower-doodle__annotation {
    position: absolute;
    bottom: 1.55rem;
    left: calc(100% + 0.45rem);
    z-index: 0;
    display: grid;
    width: max-content;
    color: color-mix(in oklch, var(--foreground) 58%, transparent);
    font-family:
      "Kalam", "Patrick Hand", "Caveat", "Shadows Into Light", cursive;
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.018em;
    line-height: 1;
    opacity: 0.72;
    pointer-events: none;
    transform: rotate(-9deg);
    transform-origin: left center;
    transition:
      color 180ms ease,
      opacity 180ms ease;
    white-space: nowrap;
  }

  .flower-doodle__annotation-arrow {
    width: 3.375rem;
    height: auto;
    margin-top: 0.1rem;
    margin-left: -0.35rem;
    color: color-mix(in oklch, var(--foreground) 48%, transparent);
    opacity: 0.72;
    transform: rotate(4deg);
  }

  .flower-doodle__art {
    transform-origin: 160px 164px;
    animation: flower-breeze 320ms ease-out 1.25s 1 both;
    transition: transform 180ms ease;
  }

  .flower-doodle__petals {
    transform-origin: 162px 83px;
  }

  .flower-doodle:hover,
  .flower-doodle:focus-visible,
  .flower-doodle__avatar-link:hover,
  .flower-doodle__avatar-link:focus-visible {
    color: var(--foreground);
    opacity: 0.92;
    outline: none;
  }

  .flower-doodle__shell.is-avatar:has(.flower-doodle__avatar-link:hover)
    .flower-doodle__annotation,
  .flower-doodle__shell.is-avatar:has(.flower-doodle__avatar-link:focus-visible)
    .flower-doodle__annotation {
    color: color-mix(in oklch, var(--foreground) 78%, transparent);
    opacity: 0.9;
  }

  .flower-doodle:hover .flower-doodle__art,
  .flower-doodle:focus-visible .flower-doodle__art,
  .flower-doodle__avatar-link:hover .flower-doodle__art,
  .flower-doodle__avatar-link:focus-visible .flower-doodle__art {
    transform: rotate(2deg) scale(1.04);
    animation: none;
  }

  .flower-doodle:focus-visible,
  .flower-doodle__avatar-link:focus-visible {
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 1px var(--ring);
  }

  .flower-doodle.is-blooming .flower-doodle__petals,
  .flower-doodle__avatar-link.is-blooming .flower-doodle__petals {
    animation: flower-bloom 210ms ease-out both;
  }

  @keyframes flower-breeze {
    0% {
      transform: rotate(0deg);
    }
    45% {
      transform: rotate(2.4deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  @keyframes flower-bloom {
    0% {
      transform: scale(1);
    }
    58% {
      transform: scale(1.13) rotate(1.5deg);
    }
    100% {
      transform: scale(1.04) rotate(0deg);
    }
  }

  @media (min-width: 640px) {
    .flower-doodle {
      width: min(6.25rem, 26vw);
      color: color-mix(in oklch, var(--foreground) 70%, transparent);
      opacity: 0.7;
    }

    .flower-doodle__svg {
      transform: none;
    }

    .flower-doodle__shell.is-avatar {
      width: 3rem;
      height: 3rem;
      margin-top: 0.75rem;
    }

    .flower-doodle__avatar-link {
      color: color-mix(in oklch, var(--foreground) 70%, transparent);
    }

    .flower-doodle__annotation {
      bottom: 1.9rem;
      left: calc(100% + 0.55rem);
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 768px) {
    .flower-doodle {
      top: 1.25rem;
      right: 0;
      width: clamp(5.5rem, 13vw, 6.1rem);
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .flower-doodle {
      top: 1rem;
      right: 0.25rem;
      width: 6.1rem;
    }
  }

  @media (max-width: 420px) {
    .flower-doodle__annotation {
      bottom: 2.05rem;
      left: 1.65rem;
      font-size: 0.8125rem;
      transform: rotate(-8deg);
    }

    .flower-doodle__annotation-arrow {
      width: 2.75rem;
      margin-left: -0.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flower-doodle,
    .flower-doodle__avatar-link,
    .flower-doodle *,
    .flower-doodle__avatar-link *,
    .flower-doodle.is-blooming .flower-doodle__petals,
    .flower-doodle__avatar-link.is-blooming .flower-doodle__petals {
      animation: none;
      transition: color 150ms ease;
    }
  }
</style>
