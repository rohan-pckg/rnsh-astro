---
export interface Props {
  title: string
  backHref?: string
  backLabel?: string
  subtitle?: string
  metadata?: string
  spacing?: "default" | "compact"
}

const {
  title,
  backHref,
  backLabel = "Back",
  subtitle,
  metadata,
  spacing = "default",
} = Astro.props
const headerClass = spacing === "compact" ? "mb-10" : "mb-10"
const hasLeftAction = Astro.slots.has("leftAction") || Boolean(backHref)
const hasRightAction = Astro.slots.has("rightAction")
const hasBelow = subtitle || metadata || Astro.slots.has("metadata")
const belowClass = hasLeftAction ? "mt-2 pl-16" : "mt-2"
---

<header class={`article-shell ${headerClass}`}>
  <div class="flex min-h-10 items-center gap-6">
    {
      hasLeftAction ? (
        <slot name="leftAction">
          <a href={backHref} class="surface-button" aria-label={backLabel}>
            <i class="ri-arrow-left-line text-base" aria-hidden="true" />
          </a>
        </slot>
      ) : null
    }

    <h1 class="nav-title min-w-0 flex-1">{title}</h1>

    {
      hasRightAction ? (
        <div class="flex shrink-0 items-center">
          <slot name="rightAction" />
        </div>
      ) : null
    }
  </div>

  {
    hasBelow && (
      <div class={belowClass}>
        {subtitle && <p class="body-text">{subtitle}</p>}
        {metadata && <p class="metadata">{metadata}</p>}
        <slot name="metadata" />
      </div>
    )
  }
</header>
