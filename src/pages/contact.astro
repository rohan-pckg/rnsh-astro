---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"

type ContactLink = {
  label: string
  value: string
  href: string
  external?: boolean
}

const contacts: ContactLink[] = [
  {
    label: "Gmail",
    value: "rnsh.space@gmail.com",
    href: "mailto:rnsh.space@gmail.com",
  },
  {
    label: "Github",
    value: "rohan-pckg",
    href: "https://github.com/rohan-pckg",
    external: true,
  },
  {
    label: "Twitter",
    value: "rnsh_twt",
    href: "https://twitter.com/rnsh_twt",
    external: true,
  },
  {
    label: "Reddit",
    value: "rohan_pckg",
    href: "https://reddit.com/user/rohan_pckg",
    external: true,
  },
]
---

<Layout>
  <SiteContainer>
    <section class="section page-section" aria-labelledby="contact-page-heading">
      <h1 class="title page-title section-break-after" id="contact-page-heading">Contact</h1>

      <ul class="list">
        {
          contacts.map((contact) => (
            <li>
              <div class="list-item">
                <a
                  href={contact.href}
                  class="list-title"
                  target={contact.external ? "_blank" : undefined}
                  rel={contact.external ? "noopener noreferrer" : undefined}
                  data-sound="navigate"
                >
                  {contact.label}
                </a>
                <p class="body-text">{contact.value}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </SiteContainer>
</Layout>