---
import ArticleFooter from "@/components/article/ArticleFooter.astro"
import ArticleHeader from "@/components/article/ArticleHeader.astro"
import ArticleLayout from "@/components/article/ArticleLayout.astro"
import Layout from "@/layouts/main.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const designs = await getCollection("design")
  return designs.map((design) => ({
    params: { slug: design.id },
    props: { design },
  }))
}

const { design } = Astro.props
const { Content, headings } = await render(design)
const firstH1 = headings.find((heading) => heading.depth === 1)
const normalizeTitle = (value: string) =>
  value.trim().replace(/\s+/g, " ").toLowerCase()
const hideDuplicateTitle =
  firstH1 && normalizeTitle(firstH1.text) === normalizeTitle(design.data.title)
---

<Layout>
  <ArticleLayout headings={headings}>
    <ArticleHeader title={design.data.title} backHref="/design" />

    <div
      class={`article-content ${hideDuplicateTitle ? "article-content--hide-first-title" : ""}`}
    >
      <Content />
    </div>

    <ArticleFooter backHref="/design" backLabel="Back to designs" />
  </ArticleLayout>
</Layout>
