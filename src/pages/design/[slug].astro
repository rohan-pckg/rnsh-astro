---
import ArticleLayout from "@/components/article/ArticleLayout.astro"
import NavigationMenu from "@/components/NavigationMenu"
import Layout from "@/layouts/main.astro"
import { getReadingTime } from "@/lib/reading-time"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const designs = await getCollection("design")
  return designs.map((design) => ({
    params: { slug: design.id },
    props: { design },
  }))
}

const { design } = Astro.props
const { Content, headings } = await render(design)
const readingTime = getReadingTime(design.body)
---

<Layout title={design.data.title} description={design.data.description}>
  <ArticleLayout
    headings={headings}
    description={design.data.description}
    date={design.data.date}
    readingTime={readingTime}
  >
    <div slot="nav">
      <NavigationMenu
        segments={[
          { label: "Design", href: "/design" },
          { label: design.data.title },
        ]}
        client:idle
      />
    </div>

    <Content />
  </ArticleLayout>
</Layout>
