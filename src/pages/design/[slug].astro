---
import ArticleLayout from "@/components/article/ArticleLayout.astro"
import NavigationMenu from "@/components/NavigationMenu"
import Layout from "@/layouts/main.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const designs = await getCollection("design")
  return designs.map((design) => ({
    params: { slug: design.id },
    props: { design },
  }))
}

const { design } = Astro.props
const { Content, headings } = await render(design)

const wordCount = design.body ? design.body.trim().split(/\s+/).filter(Boolean).length : 0
const readingTime = Math.max(1, Math.ceil(wordCount / 210))
---

<Layout>
  <ArticleLayout
    headings={headings}
    title={design.data.title}
    description={design.data.description}
    date={design.data.date}
    readingTime={readingTime}
  >
    <div slot="nav">
      <NavigationMenu
        segments={[{ label: "Design", href: "/design" }, { label: design.data.title }]}
        client:load
      />
    </div>

    <Content />
  </ArticleLayout>
</Layout>
