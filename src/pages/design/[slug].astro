---
import ArticleLayout from "@/components/article/ArticleLayout.astro"
import NavigationMenu from "@/components/NavigationMenu"
import Layout from "@/layouts/main.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const designs = await getCollection("design")
  return designs.map((design) => ({
    params: { slug: design.id },
    props: { design },
  }))
}

const { design } = Astro.props
const { Content, headings } = await render(design)
---

<Layout>
  <ArticleLayout headings={headings}>
    <div slot="nav">
      <NavigationMenu
        segments={[{ label: "Projects", href: "/design" }, { label: design.data.title }]}
        client:load
      />
    </div>

    <div class="article-content">
      <Content />
    </div>
  </ArticleLayout>
</Layout>
