---
import Layout from "@/layouts/main.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const designs = await getCollection("design")
  return designs.map((design) => ({
    params: { slug: design.id },
    props: { design },
  }))
}

const { design } = Astro.props
const { Content } = await render(design)
---

<Layout>
  <div class="flex min-h-svh justify-center px-2 py-24 sm:px-16">
    <div class="flex w-full max-w-md flex-col gap-4 text-sm leading-loose">
      <a
        href="/design"
        class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
      >
        <i class="ri-arrow-left-line"></i> Back to Designs
      </a>

      <div class="my-6 flex flex-col gap-1">
        <h1 class="text-base font-medium text-foreground">
          {design.data.title}
        </h1>
        <time class="text-xs text-muted-foreground">
          {
            design.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
      </div>

      <div
        class="prose prose-sm max-w-none [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-muted-foreground [&_blockquote]:border-l-2 [&_blockquote]:border-border [&_blockquote]:pl-4 [&_blockquote]:text-muted-foreground [&_blockquote]:not-italic [&_blockquote_p]:text-muted-foreground [&_code]:bg-muted [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-xs [&_code]:text-foreground [&_h1]:mt-10 [&_h1]:mb-3 [&_h1]:text-xl [&_h1]:font-semibold [&_h1]:text-foreground [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-lg [&_h2]:font-medium [&_h2]:text-foreground [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-base [&_h3]:font-medium [&_h3]:text-foreground [&_h4]:mt-6 [&_h4]:mb-2 [&_h4]:text-sm [&_h4]:font-medium [&_h4]:text-foreground [&_h5]:mt-4 [&_h5]:mb-1 [&_h5]:text-sm [&_h5]:font-medium [&_h5]:text-muted-foreground [&_h6]:mt-4 [&_h6]:mb-1 [&_h6]:text-xs [&_h6]:font-medium [&_h6]:text-muted-foreground [&_li]:my-1 [&_li]:text-muted-foreground [&_li::marker]:text-muted-foreground [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:text-muted-foreground [&_ol_ol]:mt-1 [&_ol_ol]:mb-0 [&_ol_ol]:list-[lower-roman] [&_ol_ol]:pl-5 [&_p]:mb-6 [&_p]:leading-6 [&_p]:text-muted-foreground [&_pre]:!my-4 [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-border [&_pre]:!p-4 [&_pre]:!text-xs [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-xs [&_pre_code]:text-inherit [&_table]:w-full [&_table]:text-sm [&_td]:border [&_td]:border-border [&_td]:px-3 [&_td]:py-2 [&_th]:border [&_th]:border-border [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:font-medium [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:text-muted-foreground [&_ul_ul]:mt-1 [&_ul_ul]:mb-0 [&_ul_ul]:list-[circle] [&_ul_ul]:pl-5"
      >
        <Content />
      </div>
    </div>
  </div>
</Layout>
