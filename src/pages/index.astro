---
import ArticleListItem from "@/components/ArticleListItem.astro"
import FlowerDoodle from "@/components/FlowerDoodle.astro"
import Layout from "@/layouts/main.astro"
import PageShell from "@/components/PageShell.astro"
import { getCollection } from "astro:content"
import { contactLinks } from "@/lib/social-links"

const recentPosts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: post.data.date.toLocaleDateString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    }),
    category: post.data.category,
  }))

const inlineLinkClass = "inline-annotation"
---

<Layout>
  <PageShell class="home-shell editorial-stack">
    <section class="home-hero editorial-stack" aria-label="Introduction">
      <FlowerDoodle variant="avatar" />

      <h1 class="my-1 flex items-center">
        <span class="font-medium"
          ><span class="text-muted-foreground">Hi, I'm</span> Rohan</span
        >
        <span class="ml-3 inline-flex items-center gap-2">
          <button
            id="theme-toggle"
            class="surface-button group"
            aria-label="Toggle dark mode"
          >
            <span
              class="size-3 rounded-full bg-foreground transition-colors duration-200 ease-in-out group-hover:bg-muted-foreground"
            ></span>
          </button>
          <button
            id="sound-toggle"
            class="surface-button"
            aria-label="Disable UI sounds"
            aria-pressed="true"
          >
            <svg
              id="sound-toggle-icon"
              class="doodle-icon"
              aria-hidden="true"
            >
              <use href="#doodle-volume-up"></use>
            </svg>
          </button>
        </span>
      </h1>

      <p class="body-text">
        I'm interested in interfaces, motion, systems, and the web. You can
        explore my background and what drives my work in the
        <a
          href="/about"
          class={inlineLinkClass}
          data-sound-category="navigation">about</a
        > section, or dive straight into the
        <a
          href="/projects"
          class={inlineLinkClass}
          data-sound-category="navigation">projects</a
        > I've been shipping.
      </p>

      <p class="body-text">
        Beyond the technical stuff, this site is a personal outlet. You can
        explore my
        <a
          href="/design"
          class={inlineLinkClass}
          data-sound-category="navigation">design</a
        > experiments, dive into my
        <a
          href="/blogs"
          class={inlineLinkClass}
          data-sound-category="navigation">thoughts</a
        >, or flip through my
        <a
          href="/gallery"
          class={inlineLinkClass}
          data-sound-category="navigation">gallery</a
        > to see some of the casual photography I capture along the way.
      </p>

      <p class="body-text home-contact">
        If you'd like to get in touch, feel free to <a
          href={contactLinks.email.href}
          class="home-contact__link"
          data-sound-category="navigation">{contactLinks.email.label}</a
        > or check out my <a
          href={contactLinks.github.href}
          class="home-contact__link"
          data-sound-category="navigation">{contactLinks.github.label}</a
        >.
      </p>
    </section>

    <section class="mt-8" aria-labelledby="recent-heading">
      <div class="mb-4 flex items-center justify-between">
        <h2 id="recent-heading" class="body-text">Recent writings</h2>

        <a
          href="/blogs"
          data-sound-category="navigation"
          class="metadata transition-colors duration-200 ease-in-out hover:text-foreground focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
        >
          View all →
        </a>
      </div>

      {
        recentPosts.length > 0 ? (
          <ul class="space-y-0">
            {recentPosts.map((post) => (
              <li>
                <ArticleListItem {...post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="body-text">Nothing here yet.</p>
        )
      }
    </section>
  </PageShell>

  <script>
    import {
      getUiSoundsEnabled,
      playSound,
      setUiSoundsEnabled,
    } from "@/lib/sound"

    const toggle = document.getElementById("theme-toggle")
    if (toggle) {
      toggle.addEventListener("click", () => {
        playSound("theme")
        const isDark = document.documentElement.classList.contains("dark")
        if (isDark) {
          document.documentElement.classList.remove("dark")
          localStorage.setItem("theme", "light")
        } else {
          document.documentElement.classList.add("dark")
          localStorage.setItem("theme", "dark")
        }
      })
    }

    const soundToggle = document.getElementById("sound-toggle")
    const soundToggleIcon = document.getElementById("sound-toggle-icon")

    function renderSoundToggle() {
      if (!soundToggle || !soundToggleIcon) return

      const enabled = getUiSoundsEnabled()
      soundToggle.setAttribute("aria-pressed", String(enabled))
      soundToggle.setAttribute(
        "aria-label",
        enabled ? "Disable UI sounds" : "Enable UI sounds"
      )
      soundToggleIcon
        .querySelector("use")
        ?.setAttribute(
          "href",
          enabled ? "#doodle-volume-up" : "#doodle-volume-mute"
        )
    }

    renderSoundToggle()

    soundToggle?.addEventListener("click", () => {
      const wasEnabled = getUiSoundsEnabled()
      if (wasEnabled) playSound("theme")
      const enabled = setUiSoundsEnabled(!wasEnabled)
      if (enabled) playSound("theme")
      renderSoundToggle()
    })
  </script>

  <style>
    :global(.home-shell) {
      padding-top: 4.5rem;
    }

    .home-hero {
      position: relative;
    }

    .home-contact {
      color: color-mix(in oklch, var(--muted-foreground) 92%, transparent);
    }

    .home-contact__link {
      color: var(--foreground);
      text-decoration-line: underline;
      text-decoration-color: transparent;
      text-underline-offset: 0.18em;
      transition:
        color var(--theme-transition-duration) var(--theme-transition-easing),
        text-decoration-color var(--theme-transition-duration)
          var(--theme-transition-easing);
    }

    .home-contact__link:hover {
      color: var(--foreground);
      text-decoration-color: currentColor;
    }

    .home-contact__link:focus-visible {
      border-radius: var(--radius-sm);
      outline: none;
      box-shadow: 0 0 0 1px var(--ring);
    }

    @media (min-width: 640px) {
      :global(.home-shell) {
        padding-top: 5.5rem;
      }
    }

    @media (min-width: 1024px) {
      :global(.home-shell) {
        padding-top: 7rem;
      }
    }
  </style>
</Layout>
