---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import ThoughtsList from "@/components/ThoughtsList"
import { getCollection } from "astro:content"

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "2-digit", year: "2-digit" })

const thoughts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: formatDate(post.data.date),
  }))
---

<Layout>
  <SiteContainer class="home-container">
    <header class="hero">
      <h1 class="hero-title">Rohan Singh</h1>
      <p class="hero-description">
        I enjoy building small tools, clean interfaces, and systems that make
        everyday work a little simpler.
      </p>
    </header>

    <section class="thoughts-section" aria-labelledby="thoughts-heading">
      <h2 id="thoughts-heading" class="thoughts-label">Thoughts</h2>

      {
        thoughts.length > 0 ? (
          <ThoughtsList thoughts={thoughts} client:load />
        ) : (
          <p class="body-text">Nothing here yet.</p>
        )
      }
    </section>
  </SiteContainer>
</Layout>
