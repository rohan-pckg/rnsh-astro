---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import ProjectList from "@/components/ProjectList"
import ThoughtsList from "@/components/ThoughtsList"
import { projects } from "@/data/projects"
import { getCollection } from "astro:content"

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "2-digit", year: "2-digit" })

const thoughts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: formatDate(post.data.date),
  }))
---

<Layout>
  <SiteContainer class="home-container">
    <section class="intro-section" aria-label="Introduction">
      <p class="font-medium">
        I design and build software that is simple to use, thoughtful in detail, and built to last.
      </p>
    </section>

    <section class="projects-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="section-label">Projects</h2>

      <ProjectList projects={projects} client:load />
    </section>

    <section class="thoughts-section" aria-labelledby="thoughts-heading">
      <h2 id="thoughts-heading" class="section-label">Thoughts</h2>

      {
        thoughts.length > 0 ? (
          <ThoughtsList thoughts={thoughts} client:load />
        ) : (
          <p class="body-text">Nothing here yet.</p>
        )
      }
    </section>
  </SiteContainer>
</Layout>
