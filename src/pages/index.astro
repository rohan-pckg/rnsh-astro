---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import StoryDrawer from "@/components/home/StoryDrawer.astro"
import heroImage from "@/assets/9d6ca.png"
import { storyPresentation } from "@/data/story-presentation"
import { homeCards } from "@/data/home-cards"
import { aboutParagraphs, aboutLinks } from "@/data/home-about"
import { projects } from "@/data/projects"

/**
 * Homepage, ported 1:1 from the Figma-exported Vite project ("Interactive
 * Portfolio"): same markup, Tailwind classes, fonts and values.
 *
 * Enhancements (see src/components/home/): a fluid hover highlight, and one
 * drawer that opens, in place, a blog post (?post=<slug>), an About / Work
 * panel (?page=about|work) or the contact details (?post=contact). Post bodies
 * are fetched on demand from /posts/<slug>.json (built per post).
 */

// ---- posts -------------------------------------------------------------
const pad2 = (n: number) => String(n).padStart(2, "0")
const ddmmyy = (d: Date) =>
  `${pad2(d.getUTCDate())}-${pad2(d.getUTCMonth() + 1)}-${pad2(d.getUTCFullYear() % 100)}`
// Story dates are display strings like "10-12-22 10:00 AM" (DD-MM-YY).
const storyTime = (str: string) => {
  const m = /^(\d{2})-(\d{2})-(\d{2})/.exec(str)
  return m ? Date.UTC(2000 + +m[3], +m[2] - 1, +m[1]) : 0
}

const stories = (await getCollection("stories"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: entry.data.date,
    image: entry.data.image,
    rotated: storyPresentation[entry.id]?.rotated ?? false,
    summary: entry.data.summary,
  }))
const writing = (await getCollection("writing")).filter((p) => !p.data.draft)

// The Writing hub: every post (homepage stories + published blog posts),
// newest first. Equal dates keep their existing order (the sort is stable).
const posts = [
  ...stories.map((s) => ({
    id: s.id,
    title: s.title,
    date: s.date.slice(0, 8),
    time: storyTime(s.date),
    summary: s.summary,
    kind: "story" as const,
  })),
  ...writing.map((p) => ({
    id: p.id,
    title: p.data.title,
    date: ddmmyy(p.data.date),
    time: p.data.date.valueOf(),
    summary: p.data.description,
    kind: "writing" as const,
  })),
].sort((a, b) => b.time - a.time)

// ---- the new row's cards -------------------------------------------------
// Illustrations (src/assets/about.png / work.png) are optional: without the
// file the slot stays empty.
const cardImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/{about,work}.png",
  { eager: true }
)
const cards = homeCards.map((c) => ({
  ...c,
  img: c.image
    ? cardImages[`/src/assets/${c.image}.png`]?.default
    : undefined,
}))

// ---- "All of my work" rows: code projects + design case studies ----------
const designs = (await getCollection("design"))
  .filter((d) => !d.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

/** Everything under "All of my work". Copy lives in `summary` fields. */
const workItems = [
  ...projects.map((p) => ({
    type: "code" as const,
    title: p.title,
    summary: p.summary ?? p.description,
    tag: p.tag,
    href: p.href,
  })),
  ...designs.map((d) => ({
    type: "design" as const,
    slug: d.id,
    title: d.data.title,
    summary: d.data.summary,
    tag: String(d.data.date.getUTCFullYear()),
    href: `/?page=work&view=design&post=${d.id}`,
    image: d.data.thumbnail,
  })),
]

// Keyboard focus rings are drawn by the `.home :focus-visible` rule below.
const focusRing = "focus-visible:opacity-100"
const mono = `font-geist-mono text-[12px] leading-normal font-normal text-black uppercase underline underline-offset-1 opacity-40 transition-opacity hover:opacity-80 ${focusRing}`
---

<Layout>
  <main
    id="main-content"
    class="home relative min-h-dvh [--spacing:4px] bg-[#f9f9f9] p-2 text-black md:p-4"
  >
    <div class="first mb-2 grid gap-2 md:mb-4 md:gap-4">
    <section
      class="hero relative h-[572px] min-w-0 overflow-hidden rounded-[4px] bg-white p-4"
      aria-labelledby="profile-name"
    >
      <header class="hero-header min-w-0">
        <h1
          id="profile-name"
          class="font-geist text-[14px] leading-normal font-medium opacity-80"
        >
          Rohan Singh
        </h1>
        <p
          class="font-geist mt-1 text-[14px] leading-normal font-medium opacity-40"
        >
          Engineer &amp; Hobyist Designer
        </p>
      </header>

      {/* Decorative live clock (desktop only; display:none on phones). Empty
          until the script fills it; the width is reserved so nothing shifts. */}
      <time
        class="hero-time font-geist-mono text-[12px] leading-normal font-normal whitespace-nowrap opacity-40"
        data-clock
        aria-hidden="true"
      ></time>

      <div
        class="hero-art pointer-events-none flex min-h-0 items-center justify-center py-4 md:mr-[90px]"
      >
        <img
          class="h-auto max-h-full w-[342px] max-w-full object-contain"
          src={heroImage.src}
          width={heroImage.width}
          height={heroImage.height}
          alt="A sequence of figures evolving from a pixelated form into a person"
        />
      </div>

      <p
        class="hero-tag font-geist max-w-[292px] text-[14px] leading-normal font-medium opacity-40"
      >
        I design and build software that is simple to use, thoughtful in
        detail, and built to last.
      </p>

      {/* One real button: bottom-right on desktop, under the tagline on phones. */}
      <button
        type="button"
        class="contact-btn font-geist cursor-pointer text-[14px] leading-normal font-medium"
        aria-haspopup="dialog"
        data-hub="contact"
        data-cuelume-open
        data-fluid-item
      >
        Contact
      </button>
    </section>

    <section
      class="cards grid grid-cols-[minmax(0,1fr)] gap-2 md:grid-cols-[minmax(280px,1fr)_minmax(0,2.4fr)] md:gap-4"
      aria-label="About and work"
    >
      {
        cards.map((card) => (
          <article
            class="card-new group relative min-w-0 cursor-pointer overflow-hidden rounded-[4px] bg-white"
            data-hub={card.id}
            data-cuelume-open
            data-fluid-item
            data-fluid-tint="0.012"
          >
            {card.dateLabel && (
              <time class="font-geist-mono absolute top-4 right-4 text-[12px] whitespace-nowrap leading-normal font-normal opacity-40">
                {card.dateLabel}
              </time>
            )}

            <div class="art art-free" aria-hidden="true">
              {card.img && (
                <img
                  src={card.img.src}
                  width={card.img.width}
                  height={card.img.height}
                  alt=""
                  decoding="async"
                  style={card.opacity ? `opacity:${card.opacity}` : undefined}
                />
              )}
            </div>

            <div class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-x-4">
              <h2 class="font-geist min-w-0 text-[14px] leading-normal font-medium opacity-40">
                {card.title}
              </h2>
              <a
                class={`${mono} mb-px shrink-0`}
                href={`/?page=${card.id}`}
                aria-label={`${card.action}: ${card.title}`}
                aria-haspopup="dialog"
                data-story-link
                data-fluid-item
                data-fluid-pad="3 6"
              >
                {card.action}
              </a>
            </div>
          </article>
        ))
      }
    </section>

    </div>

    <section class="posts grid grid-cols-[minmax(0,1fr)] gap-2 md:grid-cols-[minmax(0,2.4fr)_minmax(280px,1fr)] md:gap-4">
      {
        stories.map((story) => (
          <article
            class="post group relative h-[465px] min-w-0 cursor-pointer overflow-hidden rounded-[4px] bg-white"
            data-hub="writing"
            data-post={story.id}
            data-cuelume-open
            data-fluid-item
            data-fluid-tint="0.012"
          >
            <time class="font-geist-mono absolute top-4 right-4 text-[12px] whitespace-nowrap leading-normal font-normal opacity-40">
              {story.date}
            </time>

            <div class="art" aria-hidden="true">
              <div class={`art-frame ${story.rotated ? "art-rot" : "art-sq"}`}>
                <img src={story.image.src} alt="" loading="lazy" decoding="async" />
              </div>
            </div>

            <div class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-x-4">
              <h2 class="font-geist min-w-0 text-[14px] leading-normal font-medium opacity-40">
                {story.title}
              </h2>
              <a
                class={`${mono} mb-px shrink-0`}
                href={`/?page=writing&post=${story.id}`}
                aria-label={`Read ${story.title}`}
                aria-haspopup="dialog"
                data-story-link
                data-fluid-item
                data-fluid-pad="3 6"
              >
                Read
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <StoryDrawer
      posts={posts}
      about={{ paragraphs: aboutParagraphs, links: aboutLinks }}
      work={workItems}
    />
  </main>
</Layout>

<style>
  /* Hero: a grid. Desktop: clock top-right, tagline bottom-left, Contact
     bottom-right. Phones: no clock, Contact under the tagline. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "header time"
      "art art"
      "tag contact";
    column-gap: 16px;
  }
  .hero-header {
    grid-area: header;
  }
  .hero-time {
    grid-area: time;
    align-self: start;
    justify-self: end;
    min-width: 17ch; /* "06-11-26 03:15 AM", reserved so nothing shifts */
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .hero-art {
    grid-area: art;
  }
  .hero-tag {
    grid-area: tag;
    align-self: last baseline;
  }
  .contact-btn {
    grid-area: contact;
    align-self: last baseline;
    justify-self: end;
    padding: 6px 10px;
    border: 0;
    border-radius: 2px;
    background: #e3e3e3;
    color: #4a4a4a;
    transition: background-color 150ms ease;
  }
  .contact-btn:active {
    background: #d0d0d0;
  }
  @media (hover: hover) {
    .contact-btn:hover {
      background: #d9d9d9;
    }
  }

  /* Phones: no clock; Contact sits under the tagline. It keeps the desktop
     button's exact size (6px 10px); the tap area is extended invisibly. */
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      grid-template-areas:
        "header"
        "art"
        "tag"
        "contact";
    }
    .hero-time {
      display: none;
    }
    .hero-tag {
      align-self: start;
    }
    .contact-btn {
      position: relative;
      align-self: start;
      justify-self: start;
      margin-top: 22px;
    }
    /* Invisible hit area: ~49px tall, stays clear of the tagline (22px above)
       and inside the card (16px from the edge). */
    .contact-btn::after {
      content: "";
      position: absolute;
      inset: -8px -6px;
    }
  }

  /* Illustration area: everything between the date and the title. The frame
     keeps the design's crop (aspect ratio) and scales down to fit, capped at
     the original size. The sketches are transparent PNGs, so no blending. */
  .art {
    position: absolute;
    top: 44px;
    right: 16px;
    bottom: 52px;
    left: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .art-frame {
    position: relative;
    height: 100%;
    max-width: 100%;
  }
  .art-frame img {
    object-fit: cover;
  }
  /* New-row cards: the image keeps its own aspect and scales down to fit the
     slot, never cropped. */
  .art-free img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .card-new {
    height: 260px;
  }
  .art-sq {
    aspect-ratio: 273 / 223;
    max-height: 223px;
  }
  .art-sq img {
    width: 100%;
    height: 100%;
  }
  /* The arrows sketch is displayed turned 90deg: size the image from the
     frame's transposed box. */
  .art-rot {
    aspect-ratio: 271 / 353;
    max-height: 353px;
    container-type: size;
    opacity: 0.7;
  }
  .art-rot img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100cqh;
    height: 100cqw;
    max-width: none;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* Tablet / short viewports: normal scrolling page, sensible card heights. */
  @media (min-width: 768px) {
    .hero {
      height: auto;
      min-height: 420px;
    }
    .post {
      height: auto;
      min-height: 300px;
    }
    .card-new {
      height: auto;
      min-height: 240px;
    }
  }

  /* Desktop: the first screen is exactly the hero (~58%) and the About/Work row
     (~42%); with the 16px gutter and gaps they fill 100dvh, so the posts row
     starts just below the fold and the page scrolls normally to it. The floor
     keeps short windows from crushing the cards. */
  @media (min-width: 1024px) {
    .first {
      grid-template-rows: minmax(0, 1.38fr) minmax(0, 1fr);
      height: max(640px, calc(100dvh - 32px));
    }
    .hero,
    .card-new {
      height: auto;
      min-height: 0;
    }
    .cards {
      grid-template-rows: minmax(0, 1fr);
      min-height: 0;
    }
    .post {
      min-height: 360px;
    }
  }
</style>

<style is:global>
  /* Focus: nothing shows a ring for mouse or programmatic focus. Only real
     keyboard focus (:focus-visible, last input = keyboard) on links and
     buttons gets a subtle ring. */
  .home :focus {
    outline: none;
  }
  .home[data-input="keyboard"] :is(a, button):focus-visible {
    outline: 1.5px solid rgba(59, 110, 220, 0.5);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .home[data-input="keyboard"] .contact-btn:focus-visible {
    border-radius: 2px;
  }

  /* The homepage owns its own frame: drop the shared body gutter/lead, and
     use the Figma page ground. Scoped to pages that contain .home. */
  body:has(.home) {
    margin: 0;
    background-color: #f9f9f9;
  }

  /* Safety net only; the layout itself never overflows horizontally. */
  html:has(.home),
  body:has(.home) {
    max-width: 100%;
    overflow-x: clip;
  }

  /* No scribble sheet or pixel background on the homepage. */
  body:has(.home) .scribble,
  body:has(.home) .pixel-blast-fixed {
    display: none;
  }
</style>

<script is:inline>
  // Must run at parse time, i.e. before Astro's ClientRouter module registers
  // its own popstate listener, so drawer back/forward never reaches it.
  ;(function () {
    if (window.__homePopGuard) return
    window.__homePopGuard = true
    window.addEventListener("popstate", function (e) {
      var h = window.__homeDrawerPopstate
      if (h && h(e)) e.stopImmediatePropagation()
    })
  })()
</script>

<script>
  import { initHome } from "@/components/home/enhance"

  let cleanup: (() => void) | undefined
  // Runs on first load and after each ClientRouter navigation.
  document.addEventListener("astro:page-load", () => {
    cleanup?.()
    cleanup = initHome()
  })
  document.addEventListener("astro:before-swap", () => {
    cleanup?.()
    cleanup = undefined
  })
</script>
