---
import ArticleListItem from "@/components/ArticleListItem.astro"
import NavigationMenu from "@/components/NavigationMenu"
import PageShell from "@/components/PageShell.astro"
import Layout from "@/layouts/main.astro"
import { getPublishedSorted } from "@/lib/content"
import { formatDate } from "@/lib/format"
import { contactLinks } from "@/lib/social-links"

const recentPosts = (await getPublishedSorted("writing"))
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: formatDate(post.data.date),
  }))
---

<Layout
  title="Rohan Singh"
  description="Engineer and designer building small tools, clean interfaces, and systems that make everyday work a little simpler."
>
  <PageShell>
    <NavigationMenu segments={[{ label: "Menu" }]} client:idle />

    <div class="page-content">
      <header class="space-y-2">
        <h1 class="body-text">Rohan Singh</h1>
      </header>

      <section class="mt-10" aria-label="Introduction">
        <p class="body-text max-w-[62ch]">
          I enjoy building small tools, clean interfaces, and systems that make
          everyday work a little simpler.
        </p>
      </section>

      <nav class="mt-8 flex gap-6" aria-label="Contact links">
        <a class="text-link-underlined" href={contactLinks.email.href}>Email</a>
        <a class="text-link-underlined" href={contactLinks.github.href}
          >Github</a
        >
      </nav>

      <section class="mt-20" aria-labelledby="recent-heading">
        <h2 id="recent-heading" class="section-title">Recent writings</h2>

        {
          recentPosts.length > 0 ? (
            <ul class="writing-list mt-8">
              {recentPosts.map((post) => (
                <li>
                  <ArticleListItem {...post} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="body-text mt-8">Nothing here yet.</p>
          )
        }
      </section>
    </div>
  </PageShell>
</Layout>
