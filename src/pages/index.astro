---
import ArticleListItem from "@/components/ArticleListItem.astro"
import Layout from "@/layouts/main.astro"
import PageShell from "@/components/PageShell.astro"
import { getCollection } from "astro:content"

const recentPosts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: post.data.date.toLocaleDateString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    }),
    category: post.data.category,
  }))

const inlineLinkClass = "inline-annotation"
---

<Layout>
  <PageShell class="editorial-stack">
    <img
      src="/pfp.png"
      alt="Portrait of Rohan Singh"
      width="48"
      height="48"
      decoding="async"
      fetchpriority="high"
      class="size-10 rounded-xl object-cover sm:size-12"
    />

    <h1 class="page-title my-1 flex items-center gap-2">
      <span><span class="text-muted-foreground">Hi, I'm</span> Rohan</span>
      <button
        id="theme-toggle"
        class="h-3 w-3 cursor-pointer rounded-full border border-foreground bg-foreground transition-all duration-300 hover:scale-125 focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none dark:border-amber-400 dark:bg-amber-400 dark:shadow-[0_0_8px_rgba(251,191,36,0.8)]"
        aria-label="Toggle dark mode"
      >
      </button>
    </h1>

    <p class="body-text">
      I'm interested in interfaces, motion, systems, and the web. You can
      explore my background and what drives my work in the
      <a href="/about" class={inlineLinkClass}>about</a> section, or dive straight
      into the
      <a href="/projects" class={inlineLinkClass}>projects</a> I've been shipping.
    </p>

    <p class="body-text">
      Beyond the technical stuff, this site is a personal outlet. You can
      explore my
      <a href="/design" class={inlineLinkClass}>design</a> experiments, dive into
      my
      <a href="/blogs" class={inlineLinkClass}>thoughts</a>, or flip through my
      <a href="/gallery" class={inlineLinkClass}>gallery</a> to see some of the casual
      photography I capture along the way.
    </p>

    <section class="mt-8" aria-labelledby="recent-heading">
      <div class="mb-4 flex items-center justify-between">
        <h2 id="recent-heading" class="section-heading">Recent writings</h2>

        <a
          href="/blogs"
          class="metadata transition-colors duration-200 hover:text-foreground focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
        >
          View all →
        </a>
      </div>

      {
        recentPosts.length > 0 ? (
          <ul class="space-y-2">
            {recentPosts.map((post) => (
              <li>
                <ArticleListItem {...post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="body-text">Nothing here yet.</p>
        )
      }
    </section>
  </PageShell>

  <script>
    const toggle = document.getElementById("theme-toggle")
    if (toggle) {
      toggle.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark")
        if (isDark) {
          document.documentElement.classList.remove("dark")
          localStorage.setItem("theme", "light")
        } else {
          document.documentElement.classList.add("dark")
          localStorage.setItem("theme", "dark")
        }
      })
    }
  </script>
</Layout>
