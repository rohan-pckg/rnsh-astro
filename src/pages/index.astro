---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import LottiePlayer from "@/components/ui/lottie"
import DinoAnimation from "../../public/lottie/cat-peek.json"
---

<Layout>
  <div class="flex min-h-svh justify-center px-2 py-32 sm:px-16">
    <div class="flex w-full max-w-md flex-col gap-4 text-sm leading-loose">
      <a href="/">
        <LottiePlayer
          animationData={DinoAnimation}
          className="h-8 w-8"
          client:visible
        />
      </a>
      <h1 class="my-6 font-medium flex items-center gap-2">
        <span><span class="text-muted-foreground">Hi, I'm</span> Rohan</span>
        <button
          id="theme-toggle"
          class="h-3 w-3 rounded-full bg-foreground border border-foreground transition-all duration-300 hover:scale-125 focus:outline-none cursor-pointer dark:bg-amber-400 dark:border-amber-400 dark:shadow-[0_0_8px_rgba(251,191,36,0.8)]"
          aria-label="Toggle dark mode"
        >
        </button>
      </h1>

      <p class="my-6 text-sm/7 text-muted-foreground">
        I’m interested in interfaces, motion, systems, and the web. Sometimes I
        share my <span
          class="bg-blue-100 px-1 font-medium hover:bg-blue-400 hover:text-white dark:bg-blue-950/50 dark:text-blue-300 dark:hover:bg-blue-500 dark:hover:text-white transition-colors duration-200"
          ><a href="/blogs" class="pr-1"> thoughts</a><i
            class="ri-quill-pen-fill"></i>
        </span>
        sometimes I ship <span
          class="bg-indigo-100 px-1 font-medium hover:bg-indigo-400 hover:text-white dark:bg-indigo-950/50 dark:text-indigo-300 dark:hover:bg-indigo-500 dark:hover:text-white transition-colors duration-200"
          ><a href="/projects" class="pr-1">projects</a><i
            class="ri-folder-6-fill"></i>
        </span>
        and sometimes I disappear into the <span
          class="bg-orange-100 px-1 font-medium hover:bg-orange-400 hover:text-white dark:bg-orange-950/50 dark:text-orange-300 dark:hover:bg-orange-500 dark:hover:text-white transition-colors duration-200"
          ><a href="/lab" class="pr-1">lab</a><i class="ri-space-ship-2-fill"
          ></i>
        </span>
        to experiment with weird ideas. and ofcourse some <span
          class="bg-pink-100 px-1 font-medium hover:bg-pink-400 hover:text-white dark:bg-pink-950/50 dark:text-pink-300 dark:hover:bg-pink-500 dark:hover:text-white transition-colors duration-200"
          ><a href="/design" class="pr-1">design</a><i
            class="ri-artboard-2-fill"></i>
        </span>
      </p>

      <div class="contact flex gap-2.5">
        <a href="mailto:rnsh.space@gmail.com">
          <Button className="mt-2" variant={"secondary"}>
            <i class="ri-mail-line"></i>Email</Button
          >
        </a>
        <a href="https://github.com/rohan-pckg">
          <Button className="mt-2" variant={"secondary"}
            ><i class="ri-github-fill"></i>Github</Button
          >
        </a>
      </div>
    </div>
  </div>

  <script>
    const toggle = document.getElementById('theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    }
  </script>
</Layout>
