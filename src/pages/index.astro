---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import StoryDrawer from "@/components/home/StoryDrawer.astro"
import GithubBlock from "@/components/home/GithubBlock.astro"
import { homeCards } from "@/data/home-cards"
import { aboutParagraphs, aboutLinks } from "@/data/home-about"
import { projects } from "@/data/projects"
import { inkIcon } from "@/data/ink-icons"
import "@/styles/doodles.css"
import heroSvg from "@/assets/anim/hero.svg?raw"
import aboutSvg from "@/assets/anim/about.svg?raw"
import workSvg from "@/assets/anim/work.svg?raw"
import aiSvg from "@/assets/anim/ai.svg?raw"
import writeSvg from "@/assets/anim/write.svg?raw"

/**
 * Homepage, ported 1:1 from the Figma-exported Vite project ("Interactive
 * Portfolio"): same markup, Tailwind classes, fonts and values.
 *
 * Enhancements (see src/components/home/): a fluid hover highlight, and one
 * drawer that opens, in place, a blog post (?post=<slug>), an About / Work
 * panel (?page=about|work) or the contact details (?post=contact). Post bodies
 * are fetched on demand from /posts/<slug>.json (built per post).
 */

// ---- posts -------------------------------------------------------------
const pad2 = (n: number) => String(n).padStart(2, "0")
const ddmmyy = (d: Date) =>
  `${pad2(d.getUTCDate())}-${pad2(d.getUTCMonth() + 1)}-${pad2(d.getUTCFullYear() % 100)}`
// Note dates are display strings like "10-12-22 10:00 AM" (DD-MM-YY).
const storyTime = (str: string) => {
  const m = /^(\d{2})-(\d{2})-(\d{2})/.exec(str)
  return m ? Date.UTC(2000 + +m[3], +m[2] - 1, +m[1]) : 0
}

// The homepage's bottom cards. "notes" cards are short notes that open in the
// Notes hub; the "writing" card opens the Writing hub (the blog posts).
const notes = (await getCollection("notes"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: entry.data.date,
    hub: entry.data.hub,
    card: entry.data.card,
    summary: entry.data.summary,
  }))
const blogs = (await getCollection("writing")).filter((p) => !p.data.draft)

// Everything the drawer can open in its left column, newest first (equal dates
// keep their existing order).
const posts = [
  ...notes
    .filter((n) => n.hub === "notes")
    .map((n) => ({
      id: n.id,
      title: n.title,
      date: n.date.slice(0, 8),
      time: storyTime(n.date),
      summary: n.summary,
      kind: "note" as const,
      hub: "notes" as const,
    })),
  ...blogs.map((p) => ({
    id: p.id,
    title: p.data.title,
    date: ddmmyy(p.data.date),
    time: p.data.date.valueOf(),
    summary: p.data.description,
    kind: "blog" as const,
    hub: "writing" as const,
  })),
].sort((a, b) => b.time - a.time)
/** The sentence that introduces the Writing hub (the Write-it card's summary). */
const writingIntro = notes.find((n) => n.hub === "writing")?.summary

// ---- the new row's cards -------------------------------------------------
// Illustrations (src/assets/about.svg / work.svg) are optional: without the
// file the slot stays empty.
// Animated inline doodles (src/assets/anim): the cards' graphics.
const cardSvgs: Record<string, string> = { about: aboutSvg, work: workSvg }
const noteSvgs: Record<string, string> = {
  "in-the-age-of-ai": aiSvg,
  "write-it-before-you-forget": writeSvg,
}
const cards = homeCards.map((c) => ({
  ...c,
  svg: c.image ? cardSvgs[c.image] : undefined,
}))

// ---- "All of my work" rows: code projects + design case studies ----------
const designs = (await getCollection("design"))
  .filter((d) => !d.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

/** Everything under "All of my work". Copy lives in `summary` fields. */
const workItems = [
  ...projects.map((p) => ({
    type: "code" as const,
    title: p.title,
    summary: p.summary ?? p.description,
    tag: p.tag,
    href: p.href,
  })),
  ...designs.map((d) => ({
    type: "design" as const,
    slug: d.id,
    title: d.data.title,
    summary: d.data.summary,
    tag: String(d.data.date.getUTCFullYear()),
    href: `/?page=work&view=design&post=${d.id}`,
    image: d.data.thumbnail,
  })),
]

// Keyboard focus rings are drawn by the `.home :focus-visible` rule below.
const focusRing = "focus-visible:opacity-100"
const mono = `font-geist-mono text-[12px] leading-normal font-normal text-[rgb(var(--h-ink))] uppercase underline underline-offset-1 opacity-40 transition-opacity hover:opacity-80 ${focusRing}`
---

<Layout>
  <main
    id="main-content"
    class="home relative min-h-dvh [--spacing:4px] bg-(--h-ground) p-2 text-[rgb(var(--h-ink))] md:p-4"
  >
    <div class="first mb-2 grid gap-2 md:mb-4 md:gap-4">
    <section
      class="hero relative h-[572px] min-w-0 overflow-hidden rounded-[4px] bg-(--h-paper) p-4"
      aria-labelledby="profile-name"
    >
      <header class="hero-header min-w-0">
        <h1
          id="profile-name"
          class="font-geist text-[14px] leading-normal font-medium opacity-80"
        >
          Rohan Singh
        </h1>
        <p
          class="font-geist mt-1 text-[14px] leading-normal font-medium opacity-40"
        >
          Engineer &amp; Hobyist Designer
        </p>
      </header>

      {/* Light/dark toggle: a hand-drawn moon (light mode) or sun (dark mode). */}
      <button
        type="button"
        class="theme-btn"
        data-theme-btn
        data-fluid-item
        data-fluid-pad="3 3"
        aria-label="Switch to dark theme"
        aria-pressed="false"
      >
        <Fragment set:html={inkIcon("moon", 16)} />
        <Fragment set:html={inkIcon("sun", 16)} />
      </button>

      <div
        class="hero-art pointer-events-none flex min-h-0 items-center justify-center py-4 md:mr-[90px]"
      >
        <div
          class="doodle hero-doodle"
          role="img"
          aria-label="A sequence of figures evolving from an ape on all fours into a person holding a spear"
          set:html={heroSvg}
        />
      </div>

      <p
        class="hero-tag font-geist max-w-[292px] text-[14px] leading-normal font-medium opacity-40"
      >
        I design and build software that is simple to use, thoughtful in
        detail, and built to last.
      </p>

      {/* One real button: bottom-right on desktop, under the tagline on phones. */}
      <button
        type="button"
        class="contact-btn font-geist cursor-pointer text-[14px] leading-normal font-medium"
        aria-haspopup="dialog"
        data-hub="contact"
        data-cuelume-open
        data-fluid-item
      >
        Contact
      </button>
    </section>

    <section
      class="cards grid grid-cols-[minmax(0,1fr)] gap-2 md:grid-cols-[minmax(280px,1fr)_minmax(0,2.4fr)] md:gap-4"
      aria-label="About and work"
    >
      {
        cards.map((card) => (
          <article
            class="card-new group relative min-w-0 cursor-pointer overflow-hidden rounded-[4px] bg-(--h-paper)"
            data-hub={card.id}
            data-cuelume-open
            data-fluid-item
            data-fluid-tint="0.012"
          >
            {card.dateLabel && (
              <time class="font-geist-mono absolute top-4 right-4 max-md:hidden text-[12px] whitespace-nowrap leading-normal font-normal opacity-40">
                {card.dateLabel}
              </time>
            )}

            <div class="art art-free" aria-hidden="true">
              {card.svg && <div class="doodle" set:html={card.svg} />}
            </div>

            <div class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-x-4">
              <h2 class="font-geist min-w-0 text-[14px] leading-normal font-medium opacity-40">
                {card.title}
              </h2>
              <a
                class={`${mono} mb-px shrink-0`}
                href={`/?page=${card.id}`}
                aria-label={`${card.action}: ${card.title}`}
                aria-haspopup="dialog"
                data-story-link
                data-fluid-item
                data-fluid-pad="3 6"
              >
                <Fragment set:html={inkIcon("arrow", 16)} />
              </a>
            </div>
          </article>
        ))
      }
    </section>

    </div>

    <section class="posts grid grid-cols-[minmax(0,1fr)] gap-2 md:grid-cols-[minmax(0,2.4fr)_minmax(280px,1fr)] md:gap-4">
      {
        notes.filter((n) => n.card).map((story) => (
          <article
            class="post group relative h-[300px] min-w-0 cursor-pointer overflow-hidden rounded-[4px] bg-(--h-paper)"
            data-hub={story.hub}
            data-post={story.hub === "notes" ? story.id : undefined}
            data-cuelume-open
            data-fluid-item
            data-fluid-tint="0.012"
          >
            <time class="font-geist-mono absolute top-4 right-4 max-md:hidden text-[12px] whitespace-nowrap leading-normal font-normal opacity-40">
              {story.date}
            </time>

            <div class="art" aria-hidden="true">
              <div class="doodle art-solo" set:html={noteSvgs[story.id]} />
            </div>

            <div class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-x-4">
              <h2 class="font-geist min-w-0 text-[14px] leading-normal font-medium opacity-40">
                {story.title}
              </h2>
              <a
                class={`${mono} mb-px shrink-0`}
                href={story.hub === "notes" ? `/?page=notes&post=${story.id}` : `/?page=${story.hub}`}
                aria-label={`Read ${story.title}`}
                aria-haspopup="dialog"
                data-story-link
                data-fluid-item
                data-fluid-pad="3 6"
              >
                <Fragment set:html={inkIcon("arrow", 16)} />
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <GithubBlock />

    <StoryDrawer
      posts={posts}
      writingIntro={writingIntro}
      about={{ paragraphs: aboutParagraphs, links: aboutLinks }}
      work={workItems}
    />
  </main>
</Layout>

<style>
  /* Hero: a grid. Desktop: tagline bottom-left, Contact
     bottom-right. Phones: Contact under the tagline. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "header time"
      "art art"
      "tag contact";
    column-gap: 16px;
  }
  .hero-header {
    grid-area: header;
  }
  /* Theme toggle: top-right corner of the hero, a 16px ink-doodle icon with
     an 8px padded hit area (the hero is position: relative). */
  .theme-btn {
    position: absolute;
    top: 10px;
    right: 8px;
    z-index: 1;
    padding: 8px;
    border: 0;
    background: none;
    color: rgb(var(--h-ink));
    line-height: 0;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) {
    .theme-btn:hover {
      opacity: 0.9;
    }
  }
  .hero-art {
    grid-area: art;
  }
  .hero-tag {
    grid-area: tag;
    align-self: last baseline;
  }
  .contact-btn {
    grid-area: contact;
    align-self: last baseline;
    justify-self: end;
    padding: 6px 10px;
    border: 0;
    border-radius: 2px;
    background: var(--h-chip);
    color: var(--h-chip-ink);
    transition: background-color 150ms ease;
  }
  .contact-btn:active {
    background: var(--h-chip-down);
  }
  @media (hover: hover) {
    .contact-btn:hover {
      background: var(--h-chip-hover);
    }
  }

  /* Phones: Contact sits under the tagline. It keeps the desktop
     button's exact size (6px 10px); the tap area is extended invisibly. */
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      grid-template-areas:
        "header"
        "art"
        "tag"
        "contact";
    }
    .hero-tag {
      align-self: start;
    }
    .contact-btn {
      position: relative;
      align-self: start;
      justify-self: start;
      margin-top: 22px;
    }
    /* Invisible hit area: ~49px tall, stays clear of the tagline (22px above)
       and inside the card (16px from the edge). */
    .contact-btn::after {
      content: "";
      position: absolute;
      inset: -8px -6px;
    }
  }

  /* Illustration area: everything between the date and the title. The frame
     keeps the design's crop (aspect ratio) and scales down to fit, capped at
     the original size. The sketches are transparent PNGs, so no blending. */
  .art {
    position: absolute;
    top: 44px;
    right: 16px;
    bottom: 52px;
    left: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  /* Phones: the cards carry no date, so the art can use that space. */
  @media (max-width: 767px) {
    .art {
      top: 16px;
    }
  }
  /* New-row cards: the image keeps its own aspect and scales down to fit the
     slot, never cropped. */
  .card-new {
    height: 300px;
  }

  /* Tablet / short viewports: normal scrolling page, sensible card heights. */
  @media (min-width: 768px) {
    .hero {
      height: auto;
      min-height: 420px;
    }
    .post {
      height: auto;
      min-height: 300px;
    }
    .card-new {
      height: auto;
      min-height: 240px;
    }
  }

  /* Desktop: the first screen is exactly the hero (~58%) and the About/Work row
     (~42%); with the 16px gutter and gaps they fill 100dvh, so the posts row
     starts just below the fold and the page scrolls normally to it. The floor
     keeps short windows from crushing the cards. */
  @media (min-width: 1024px) {
    .first {
      grid-template-rows: minmax(0, 1.38fr) minmax(0, 1fr);
      height: max(640px, calc(100dvh - 32px));
    }
    .hero,
    .card-new {
      height: auto;
      min-height: 0;
    }
    .cards {
      grid-template-rows: minmax(0, 1fr);
      min-height: 0;
    }
    .post {
      min-height: 360px;
    }
  }
</style>

<style is:global>
  /* Homepage palette. Every colour on the page reads these, so dark mode is a
     second set of values (the dark neutrals match global.css's dark theme). */
  :root {
    --h-ink: 0 0 0; /* text / lines, as an "r g b" triplet for alpha use */
    --h-ground: #f9f9f9;
    --h-paper: #ffffff;
    --h-surface: #f4f4f4;
    --h-surface2: #f6f6f6;
    --h-chip: #e3e3e3;
    --h-chip-ink: #4a4a4a;
    --h-chip-hover: #d9d9d9;
    --h-chip-down: #d0d0d0;
  }
  :root[data-theme="dark"] {
    --h-ink: 238 238 236;
    --h-ground: #0d0d0c;
    --h-paper: #171717;
    --h-surface: #232321;
    --h-surface2: #21211f;
    --h-chip: #2c2c29;
    --h-chip-ink: #d6d6d2;
    --h-chip-hover: #363632;
    --h-chip-down: #403f3b;
  }
  .doodle svg {
    display: block;
    width: 190px;
    height: 190px;
    max-width: 100%;
  }
  .hero-doodle svg {
    width: 440px;
    height: auto;
  }
  /* Phones: slightly smaller card illustrations (the cards are a bit taller). */
  @media (max-width: 767px) {
    .art .doodle svg {
      width: 160px;
      height: 160px;
    }
  }
  /* The doodle art is dark ink on transparent: flip it to light ink. */
  :root[data-theme="dark"] :is(.hero-art, .art, .sd-art) img,
  :root[data-theme="dark"] .doodle svg {
    filter: invert(1);
  }
  /* The drawer panel is the same grey as the cards: give it an edge. */
  :root[data-theme="dark"] .sd-panel {
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgb(var(--h-ink) / 0.1);
  }
  .theme-btn svg {
    display: block;
  }
  .theme-btn .i-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-btn .i-moon {
    display: none;
  }
  :root[data-theme="dark"] .theme-btn .i-sun {
    display: block;
  }

  /* Focus: nothing shows a ring for mouse or programmatic focus. Only real
     keyboard focus (:focus-visible, last input = keyboard) on links and
     buttons gets a subtle ring. */
  .home :focus {
    outline: none;
  }
  .home[data-input="keyboard"] :is(a, button):focus-visible {
    outline: 1.5px solid rgba(59, 110, 220, 0.5);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .home[data-input="keyboard"] .contact-btn:focus-visible {
    border-radius: 2px;
  }

  /* The homepage owns its own frame: drop the shared body gutter/lead, and
     use the Figma page ground. Scoped to pages that contain .home. */
  body:has(.home) {
    margin: 0;
    background-color: var(--h-ground);
  }

  /* Safety net only; the layout itself never overflows horizontally. */
  html:has(.home),
  body:has(.home) {
    max-width: 100%;
    overflow-x: clip;
  }

  /* No scribble sheet or pixel background on the homepage. */
  body:has(.home) .scribble,
  body:has(.home) .pixel-blast-fixed {
    display: none;
  }
</style>

<script is:inline>
  // Must run at parse time, i.e. before Astro's ClientRouter module registers
  // its own popstate listener, so drawer back/forward never reaches it.
  ;(function () {
    if (window.__homePopGuard) return
    window.__homePopGuard = true
    window.addEventListener("popstate", function (e) {
      var h = window.__homeDrawerPopstate
      if (h && h(e)) e.stopImmediatePropagation()
    })
  })()
</script>

<script>
  import { initHome } from "@/components/home/enhance"

  // Doodles animate only while on screen (and restart when they come back).
  let doodleObserver: IntersectionObserver | undefined
  const watchDoodles = () => {
    doodleObserver?.disconnect()
    doodleObserver = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => e.target.classList.toggle("play", e.isIntersecting)),
      { threshold: 0.25 }
    )
    document.querySelectorAll(".doodle, .gh-graph").forEach((el) => doodleObserver!.observe(el))
  }

  let cleanup: (() => void) | undefined
  // Runs on first load and after each ClientRouter navigation.
  document.addEventListener("astro:page-load", () => {
    cleanup?.()
    cleanup = initHome()
    watchDoodles()
  })
  document.addEventListener("astro:before-swap", () => {
    cleanup?.()
    cleanup = undefined
  })
</script>
