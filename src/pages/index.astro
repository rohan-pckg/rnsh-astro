---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import ThoughtList from "@/components/ThoughtList.astro"
import ProjectList from "@/components/ProjectList.astro"
import { projects } from "@/data/projects"
import { getCollection } from "astro:content"

const thoughts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: post.data.date,
  }))

const featuredProjects = projects.map((project) => ({
  title: project.title,
  href: project.href,
  external: project.external,
}))
---

<Layout>
  <SiteContainer class="home-container">
    <div class="home-redesign">
      <section class="home-hero" aria-label="Introduction">
        <h1>Hi, I&rsquo;m Rohan.</h1>
        <p>
          I design and build software that is simple to use, thoughtful in
          detail, and built to last.
        </p>
        <p>
          Based in Mumbai, India, I&rsquo;m an engineer blending a Computer
          Science background with front-end architecture and interface design.
          I&rsquo;m currently a Software Engineer at Hoora, crafting
          high-fidelity digital experiences.
        </p>
      </section>

      <section class="home-section" aria-labelledby="thoughts-heading">
        <div class="home-section-head">
          <h2 id="projects-heading">Thoughts</h2>
          <span class="section-rule" aria-hidden="true"></span>
        </div>
        {
          thoughts.length > 0 ? (
            <ThoughtList items={thoughts} groupByYear={false} />
          ) : (
            <p class="body-text">Nothing here yet.</p>
          )
        }
      </section>

      <section class="home-section" aria-labelledby="projects-heading">
        <div class="home-section-head">
          <h2 id="projects-heading">Projects</h2>
          <span class="section-rule" aria-hidden="true"></span>
                 </div>

        <ProjectList items={featuredProjects} />
      </section>
    </div>
  </SiteContainer>
</Layout>
