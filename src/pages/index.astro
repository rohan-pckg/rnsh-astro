---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import ThemeControl from "@/components/ThemeControl.astro"
import { navRoutes, isNavRouteActive } from "@/data/navigation"

/**
 * The homepage is the design's index page reproduced: four blocks of text in a
 * narrow measure against the left margin, separated by viewport-relative
 * whitespace, with navigation stated as content rather than chrome. No hero, no
 * cards, no artwork.
 *
 * `footer={false}` because this page already is the navigation.
 */
const pathname = Astro.url.pathname
---

<Layout>
  <SiteContainer footer={false}>
    <section class="section">
      <h1 class="title">Rohan Singh</h1>
      <p class="body-text">Engineer</p>
    </section>

    <section class="section">
      <h2 class="title">Today</h2>
      <p class="body-text">
        Working as a software Engineer at Hoora, crafting high-fidelity digital
        experiences.
      </p>
    </section>

    <section class="section">
      <h2 class="title">About</h2>
      <p class="body-text">
       Generalist at heart, drawn to design and increasingly curious about code.
      </p>
    </section>

    <section class="section" aria-labelledby="navigation-heading">
      <h2 class="title" id="navigation-heading">Navigation</h2>
      <nav class="nav" aria-label="Site">
        {
          navRoutes.map((route) => (
            <a
              href={route.href}
              class="navigation-link"
              aria-current={
                isNavRouteActive(route, pathname) ? "page" : undefined
              }
              data-sound="navigate"
            >
              ++ /{route.label}
            </a>
          ))
        }

        <ThemeControl />
      </nav>
    </section>
  </SiteContainer>
</Layout>