---
import IndexList from "@/components/IndexList.astro"
import PageHeader from "@/components/PageHeader.astro"
import PageShell from "@/components/PageShell.astro"
import Layout from "@/layouts/main.astro"
import { getCollection } from "astro:content"

const designs = (await getCollection("design"))
  .filter((d) => !d.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((design) => ({
    title: design.data.title,
    href: `/design/${design.id}`,
    date: design.data.date,
    thumbnail: design.data.thumbnail,
  }))
---

<Layout>
  <PageShell>
    <PageHeader title="Design" />
    <IndexList items={designs} />
  </PageShell>
</Layout>
