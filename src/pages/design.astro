---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import { getCollection } from "astro:content"

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "2-digit", year: "2-digit" })

const designs = (await getCollection("design"))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout>
  <SiteContainer>
    <div class="page-body">
      <section class="home-section" aria-labelledby="designs-heading">
        <div class="home-section-head">
          <h1 id="designs-heading">Designs</h1>
        </div>

        <div class="design-showcase-list">
          {
            designs.map((item) => (
              <a
                href={`/design/${item.id}`}
                class="design-showcase"
                data-sound="navigate"
              >
                <div class="design-showcase-visual">
                  <img
                    src={item.data.thumbnail}
                    alt={item.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="design-showcase-meta">
                  <p class="design-showcase-title">{item.data.title}</p>
                  <p class="design-showcase-date">
                    {formatDate(item.data.date)}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </SiteContainer>
</Layout>
