---
import IndexList from "@/components/IndexList.astro"
import NavigationMenu from "@/components/NavigationMenu"
import PageShell from "@/components/PageShell.astro"
import Layout from "@/layouts/main.astro"
import { getPublishedSorted } from "@/lib/content"

const designs = (await getPublishedSorted("design")).map((design) => ({
  title: design.data.title,
  href: `/design/${design.id}`,
  date: design.data.date,
  thumbnail: design.data.thumbnail,
}))
---

<Layout title="Design" description="Selected design work and case studies.">
  <PageShell>
    <NavigationMenu segments={[{ label: "Design" }]} client:idle />
    <div class="page-content">
      <IndexList items={designs} />
    </div>
  </PageShell>
</Layout>
