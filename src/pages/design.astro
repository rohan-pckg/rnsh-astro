---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import { getCollection } from "astro:content"

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "2-digit", year: "2-digit" })

const designs = (await getCollection("design"))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout>
  <SiteContainer>
    <section class="section page-section" aria-labelledby="designs-heading">
      <h1 class="title page-title section-break-after" id="designs-heading">Designs</h1>

      {
        designs.map((item) => (
          <article class="entry">
            <a
              href={`/design/${item.id}`}
              class="entry-title"
              data-sound="navigate"
            >
              {item.data.title}
            </a>
            <p class="date">{formatDate(item.data.date)}</p>
            {/* Pointer devices float this to the bottom-right on hover; touch
                devices get it inline at the full content width. */}
            <img
              class="preview"
              src={item.data.thumbnail}
              alt={item.data.title}
              loading="lazy"
              decoding="async"
            />
          </article>
        ))
      }
    </section>
  </SiteContainer>
</Layout>