---
import PageHeader from "@/components/PageHeader.astro"
import PageShell from "@/components/PageShell.astro"
import Layout from "@/layouts/main.astro"
---

<Layout>
  <PageShell>
    <PageHeader title="Postcard Hall of Fame" backHref="/" subtitle="Handpicked postcards sent in by visitors." />

    <div class="editorial-stack">
      <p class="body-text">
        No postcards yet. If you make one you like, send it over —
        <a
          href="mailto:rohan@rnsh.in?subject=Postcard%20Hall%20of%20Fame"
          class="inline-annotation"
        >
          rohan@rnsh.in
        </a>
        — and it might end up here.
      </p>
    </div>
  </PageShell>
</Layout>
