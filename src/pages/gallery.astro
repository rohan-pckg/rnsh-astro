---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"

/**
 * Drop your CDN URLs here.
 * Mix portrait/landscape shots for a natural rhythm down the column.
 */
const photos: { src: string; alt: string }[] = [
  {
    src: "https://res.cloudinary.com/ddznytnco/image/upload/v1780612569/588168828_17861161749550924_8301708971962220453_n_fbkf0s.jpg",
    alt: "Street photograph from Rohan's gallery",
  },
  {
    src: "https://res.cloudinary.com/ddznytnco/image/upload/v1780612569/588842121_17861161536550924_9053216440401849384_n_afhps8.jpg",
    alt: "Outdoor photograph from Rohan's gallery",
  },
]
---

<Layout>
  <SiteContainer>
    <section class="section page-section" aria-labelledby="gallery-heading">
      <h1 class="title page-title section-break-after" id="gallery-heading">Gallery</h1>

      <div class="gallery">
        {
          photos.length > 0 ? (
            photos.map((photo, i) => (
              <figure>
                <button
                  class="gallery-item"
                  data-src={photo.src}
                  data-index={String(i)}
                  aria-label={`Open photo ${i + 1}`}
                  data-sound="open"
                >
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </figure>
            ))
          ) : (
            <p class="body-text">Nothing here yet.</p>
          )
        }
      </div>
    </section>
  </SiteContainer>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="lightbox is-hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
  >
    <button id="lb-close" class="lightbox-close" aria-label="Close">
      Close
    </button>
    <button id="lb-prev" class="lightbox-step" aria-label="Previous">
      Prev
    </button>
    <img id="lb-img" src="" alt="" class="lightbox-image" />
    <button id="lb-next" class="lightbox-step" aria-label="Next">
      Next
    </button>
    <span id="lb-count" class="lightbox-count"></span>
  </div>

  <script>
    const items = [
      ...document.querySelectorAll<HTMLButtonElement>(".gallery-item"),
    ]
    const lb = document.getElementById("lightbox")!
    const lbImg = document.getElementById("lb-img") as HTMLImageElement
    const lbCnt = document.getElementById("lb-count")!
    const srcs = items.map((el) => ({
      src: el.dataset.src ?? "",
      alt: el.querySelector("img")?.alt ?? "",
    }))
    let cur = 0
    let activeTrigger: HTMLButtonElement | null = null

    function nav(i: number) {
      cur = ((i % srcs.length) + srcs.length) % srcs.length
      lbImg.src = srcs[cur].src
      lbImg.alt = srcs[cur].alt
      lbCnt.textContent = `${cur + 1} / ${srcs.length}`
    }
    function open(i: number) {
      activeTrigger = items[i] ?? null
      nav(i)
      lb.classList.replace("is-hidden", "is-open")
      document.body.style.overflow = "hidden"
      document.getElementById("lb-close")?.focus()
    }
    function close() {
      lb.classList.replace("is-open", "is-hidden")
      document.body.style.overflow = ""
      activeTrigger?.focus()
    }

    function trapFocus(e: KeyboardEvent) {
      if (e.key !== "Tab" || lb.classList.contains("is-hidden")) return

      const focusable = [
        ...lb.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        ),
      ].filter((el) => !el.hasAttribute("disabled"))

      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (!first || !last) return

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault()
        last.focus()
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault()
        first.focus()
      }
    }

    items.forEach((el, i) => el.addEventListener("click", () => open(i)))
    document.getElementById("lb-close")!.addEventListener("click", close)
    document
      .getElementById("lb-prev")!
      .addEventListener("click", () => nav(cur - 1))
    document
      .getElementById("lb-next")!
      .addEventListener("click", () => nav(cur + 1))
    lb.addEventListener("click", (e) => {
      if (e.target === lb) close()
    })
    document.addEventListener("keydown", (e) => {
      if (lb.classList.contains("is-hidden")) return
      if (e.key === "Escape") close()
      if (e.key === "ArrowLeft") nav(cur - 1)
      if (e.key === "ArrowRight") nav(cur + 1)
      trapFocus(e)
    })
  </script>
</Layout>