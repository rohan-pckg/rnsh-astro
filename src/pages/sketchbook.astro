---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import SketchbookCanvas from "@/components/sketchbook/SketchbookCanvas"
---

<Layout>
  <SiteContainer>
    <section class="section page-section" aria-labelledby="lab-page-heading">
      <h1 class="title page-title section-break-after" id="lab-page-heading">Lab</h1>

      <p class="body-text">
        A quiet notebook for loose lines, quick shapes, and ideas that do not
        need to become anything yet.
      </p>

      <SketchbookCanvas client:load />
    </section>
  </SiteContainer>
</Layout>