---
/**
 * Doodle lab: an unlinked playground for animating the ink doodles.
 * Open /doodle-lab. Each card is an inline SVG (src/assets/anim, generated by
 * originals/doodles/ink_anim.py) whose parts are moved with CSS only.
 * Replay restarts a card; "Boil" adds the hand-drawn line shimmer.
 */
import Layout from "@/layouts/main.astro"
import "@/styles/doodles.css"
import about from "@/assets/anim/about.svg?raw"
import work from "@/assets/anim/work.svg?raw"
import ai from "@/assets/anim/ai.svg?raw"
import write from "@/assets/anim/write.svg?raw"
import hero from "@/assets/anim/hero.svg?raw"

const cards = [
  { id: "hero", title: "Hero", note: "Figures arrive one by one and the ground draws on, then each sways.", svg: hero, wide: true },
  { id: "about", title: "More about me", note: "Head bobs, the starburst spins and pulses, ticks scribble in and out.", svg: about },
  { id: "work", title: "Design and code", note: "Lines are written on, </> appears, the cursor glides in and clicks.", svg: work },
  { id: "ai", title: "In the age of AI.", note: "The tree grows from the hand: branches draw up, nodes pop in.", svg: ai },
  { id: "write", title: "Write it before you forget!", note: "Notes float and fill with scribble while the quill writes.", svg: write },
]
---

<Layout>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  {/* Three copies of the same displacement filter with different seeds; the
      "boil" animation flips between them a few times a second. */}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    {[1, 2, 3].map((seed) => (
      <filter id={`boil${seed}`} x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed={seed * 7} result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3.4" />
      </filter>
    ))}
  </svg>

  <main class="lab">
    <header class="lab-head">
      <h1>Doodle lab</h1>
      <p>Animation ideas for the ink doodles. Pick what you like.</p>
      <label class="lab-boil"><input type="checkbox" id="boil" /> Boil (hand-drawn shimmer)</label>
    </header>

    <div class="lab-grid">
      {
        cards.map((c) => (
          <section class:list={["lab-card", { wide: c.wide }]} data-card={c.id}>
            <div class="lab-top">
              <h2>{c.title}</h2>
              <button type="button" class="lab-replay" data-replay aria-label={`Replay ${c.title}`}>Replay</button>
            </div>
            <div class={`lab-art doodle lab-${c.id} play`} set:html={c.svg} />
            <p class="lab-note">{c.note}</p>
          </section>
        ))
      }
    </div>
  </main>
</Layout>

<script>
  // Replay: drop the class, force a reflow, add it back.
  document.querySelectorAll<HTMLButtonElement>("[data-replay]").forEach((b) => {
    b.addEventListener("click", () => {
      const art = b.closest(".lab-card")!.querySelector<HTMLElement>(".lab-art")!
      art.classList.remove("play")
      void art.offsetWidth
      art.classList.add("play")
    })
  })
  const boil = document.getElementById("boil") as HTMLInputElement
  boil?.addEventListener("change", () =>
    document.querySelector(".lab")!.classList.toggle("is-boil", boil.checked)
  )
</script>

<style is:global>
  .lab {
    --ink: #161412;
    min-height: 100dvh;
    padding: 32px 16px 64px;
    background: #f9f9f9;
    color: #161412;
    font-family: "Geist", system-ui, sans-serif;
  }
  :root[data-theme="dark"] .lab {
    background: #0d0d0c;
    color: #eeeeec;
  }
  body:has(.lab) { margin: 0; background: #f9f9f9; }
  html:has(.lab), body:has(.lab) { max-width: 100%; overflow-x: clip; }
  :root[data-theme="dark"] body:has(.lab) { background: #0d0d0c; }
  .lab-head { max-width: 1100px; margin: 0 auto 24px; }
  .lab-head h1 { margin: 0 0 4px; font-size: 20px; font-weight: 500; }
  .lab-head p { margin: 0 0 12px; opacity: 0.6; font-size: 14px; }
  .lab-boil { font-size: 13px; cursor: pointer; }
  .lab-grid {
    display: grid;
    gap: 12px;
    max-width: 1100px;
    margin: 0 auto;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .lab-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 14px;
    border-radius: 4px;
    background: #fff;
  }
  :root[data-theme="dark"] .lab-card { background: #1a1a18; }
  .lab-card.wide { grid-column: 1 / -1; }
  .lab-top { display: flex; align-items: center; justify-content: space-between; }
  .lab-top h2 { margin: 0; font-size: 14px; font-weight: 500; opacity: 0.8; }
  .lab-replay {
    padding: 4px 8px;
    border: 0;
    border-radius: 3px;
    background: rgb(0 0 0 / 0.06);
    color: inherit;
    font: 12px "Geist Mono", monospace;
    text-transform: uppercase;
    cursor: pointer;
  }
  :root[data-theme="dark"] .lab-replay { background: rgb(255 255 255 / 0.1); }
  .lab-art { display: grid; place-items: center; padding: 12px 0; }
  .lab-art svg { width: 100%; max-width: 230px; height: auto; overflow: visible; }
  .lab-hero svg { max-width: 520px; }
  :root[data-theme="dark"] .lab-art svg { filter: invert(1); }
  .lab-note { margin: 0; font-size: 12px; opacity: 0.5; }

  /* ---- hand-drawn "boil": flip between three displaced copies --------- */
  @media (prefers-reduced-motion: no-preference) {
    .is-boil .lab-art svg { animation: boil 0.6s steps(1) infinite; }
    :root[data-theme="dark"] .is-boil .lab-art svg { animation-name: boil-dark; }
    @keyframes boil {
      0% { filter: url(#boil1); } 33% { filter: url(#boil2); } 66% { filter: url(#boil3); }
    }
    @keyframes boil-dark {
      0% { filter: invert(1) url(#boil1); } 33% { filter: invert(1) url(#boil2); } 66% { filter: invert(1) url(#boil3); }
    }
  }

</style>
