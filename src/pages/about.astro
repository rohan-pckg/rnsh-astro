---
import Layout from "@/layouts/main.astro"

const pfp = "/me.png"
---

<Layout>
  <div class="flex min-h-svh justify-center px-2 py-24 sm:px-16">
    <div class="flex w-full max-w-md flex-col gap-4 text-sm leading-loose">
      <a
        href="/"
        class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
      >
        <i class="ri-arrow-left-line"></i> Back
      </a>

      <h1 class="my-4 font-medium">
        <span class="text-muted-foreground opacity-50">So, who am I?</span>
      </h1>

      <!-- Profile -->
      <div class="flex flex-col gap-3">
        <img src={pfp} alt="Rohan Singh" class="" />
        <span class="font-medium">Rohan Singh</span>
      </div>

      <!-- Bio -->
      <p class="text-sm/6 text-muted-foreground">
        Based in Mumbai, India, I’m a 23-year-old engineer blending a formal
        background in Computer Science (B.Tech, 2024) with a passion for
        front-end architecture and interface design. I'm currently working as a
        <span class="text-foreground">Software Engineer</span> at <a href=""
          ><span class="text-foreground blur-xs">Hoora</span></a
        >, where I focus on crafting high-fidelity digital experiences. I’m
        obsessed with the details that often go unnoticed sharp typography,
        macro-spacing, and intentional motion.
      </p>

      <p class="text-sm/6 text-muted-foreground">
        When I step away from my desk, I'm usually wandering around taking
        photographs, walking, or overthinking something new.
      </p>

      <a
        href="https://drive.google.com/file/d/1-OwRzZ0MiUsGfCJodpC7bJmnpdQbaSHy/view?usp=sharing"
        target="_blank"
        class="inline-flex w-fit items-center gap-1.5 text-xs font-medium text-foreground underline underline-offset-4 transition-colors hover:text-orange-500"
      >
        View Resume
      </a>
    </div>
  </div>
</Layout>
