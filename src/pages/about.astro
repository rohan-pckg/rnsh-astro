---
import Layout from "@/layouts/main.astro"
import PageHeader from "@/components/PageHeader.astro"
import PageShell from "@/components/PageShell.astro"

const pfp = "/about.jpeg"
---

<Layout>
  <PageShell>
    <PageHeader title="About" backHref="/" />

    <div class="editorial-stack">
      <div class="flex flex-col gap-3 pb-2">
        <img
          src={pfp}
          alt="Rohan Singh"
          class="rounded-md border border-border"
        />
        <span class="mt-5 font-medium">Rohan Singh</span>
      </div>

      <p class="body-text">
        Based in Mumbai, India, I’m a 23-year-old engineer blending a formal
        background in Computer Science (B.Tech, 2024) with a passion for
        front-end architecture and interface design. I'm currently working as a
        <span class="text-foreground">Software Engineer</span> at <span
          class="text-foreground">Hoora</span
        >, where I focus on crafting high-fidelity digital experiences. I’m
        obsessed with the details that often go unnoticed sharp typography,
        macro-spacing, and intentional motion.
      </p>

      <p class="body-text">
        When I step away from my desk, I'm usually wandering around taking
        photographs, walking, or overthinking something new.
      </p>

      <a
        href="https://drive.google.com/file/d/1-OwRzZ0MiUsGfCJodpC7bJmnpdQbaSHy/view?usp=sharing"
        target="_blank"
        rel="noreferrer"
        class="inline-annotation body-small inline-flex w-fit"
      >
        View Resume
      </a>
    </div>
  </PageShell>
</Layout>
