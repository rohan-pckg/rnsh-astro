---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import AboutTabs from "@/components/about/AboutTabs"

const pfp = "/about.jpeg"

// The About content opens in the homepage drawer now (About hub + the full
// content in the left column). Browsers are sent there straight away; the
// canonical points at the drawer URL, and this page stays as a no-JS fallback
// (and via ?full=1).
const drawerUrl = "/?page=about&post=full"
---

<Layout>
  <Fragment slot="head">
    <link rel="canonical" href={drawerUrl} />
    <script is:inline define:vars={{ drawerUrl }}>
      if (!/[?&]full=1/.test(location.search)) location.replace(drawerUrl)
    </script>
  </Fragment>
  <SiteContainer>
    <section class="section page-section" aria-labelledby="about-page-heading">
      <h1 class="title page-title section-break-after" id="about-page-heading">More about me!</h1>

      <figure class="about-portrait">
        <img
          src={pfp}
          alt="Rohan Singh"
          width="1440"
          height="1440"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <p class="title">Rohan Singh</p>

      <p class="body-text">
        Based in Mumbai, India, I’m a 23-year-old engineer blending a formal
        background in Computer Science (B.Tech, 2024) with a passion for
        front-end architecture and interface design. I'm currently working as a
        Software Engineer at Hoora, where I focus on crafting high-fidelity
        digital experiences. I’m obsessed with the details that often go
        unnoticed sharp typography, macro-spacing, and intentional motion.
      </p>

      <p class="body-text">
        When I step away from my desk, I'm usually wandering around taking
        photographs, walking, or overthinking something new.
      </p>

      <p>
        <a
          href="https://drive.google.com/file/d/1-OwRzZ0MiUsGfCJodpC7bJmnpdQbaSHy/view?usp=sharing"
          target="_blank"
          rel="noreferrer"
          class="link"
          data-sound="navigate"
        >
          View Resume
        </a>
      </p>

      <AboutTabs client:load />
    </section>
  </SiteContainer>
</Layout>