---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import ProjectList from "@/components/ProjectList"
import { projects } from "@/data/projects"
---

<Layout>
  <SiteContainer>
    <section class="projects-section" aria-labelledby="projects-page-heading">
      <h1 id="projects-page-heading" class="section-label">Projects</h1>

      <ProjectList projects={projects} client:load />
    </section>
  </SiteContainer>
</Layout>
