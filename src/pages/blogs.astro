---
import ThoughtList from "@/components/ThoughtList.astro"
import PageShell from "@/components/PageShell.astro"
import Layout from "@/layouts/main.astro"
import { getCollection } from "astro:content"

const thoughts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: post.data.date,
  }))
---

<Layout>
  <PageShell>
    <div class="page-body">
      <section class="home-section" aria-labelledby="thoughts-heading">
        {
          thoughts.length > 0 ? (
            <ThoughtList items={thoughts} />
          ) : (
            <p class="body-text">Nothing here yet.</p>
          )
        }
      </section>
    </div>
  </PageShell>
</Layout>
