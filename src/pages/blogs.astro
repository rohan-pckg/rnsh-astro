---
import Layout from "@/layouts/main.astro"
import LottiePlayer from "@/components/ui/lottie"
import DinoAnimation from "../../public/lottie/cat-peek.json"
import { getCollection } from "astro:content"

const posts = (await getCollection("writing"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout>
  <div class="flex min-h-svh justify-center px-6 py-32 sm:px-32">
    <div class="flex w-full max-w-3xl flex-col gap-4 text-sm leading-loose">
      <a href="/">
        <LottiePlayer
          animationData={DinoAnimation}
          className="h-8 w-8"
          client:visible
        />
      </a>

      <h1 class="my-6 font-medium">
        <span class="text-muted-foreground">Sharing my thoughts...</span>
      </h1>

      <div class="flex flex-col gap-6">
        {
          posts.map((post) => (
            <a
              href={`/writing/${post.slug}`}
              class="group flex items-baseline gap-3 transition-colors hover:text-primary"
            >
              <span class="flex-1 text-foreground group-hover:underline">
                {post.data.title}
              </span>

              <span class="flex-1 pb-1 text-border" />

              <span class="font-mono text-xs whitespace-nowrap text-muted-foreground">
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
