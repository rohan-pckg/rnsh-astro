---
import ArticleListItem from "@/components/ArticleListItem.astro"
import NavigationMenu from "@/components/NavigationMenu"
import PageShell from "@/components/PageShell.astro"
import Layout from "@/layouts/main.astro"
import { getPublishedSorted } from "@/lib/content"
import { formatDate } from "@/lib/format"

const posts = (await getPublishedSorted("writing")).map((post) => ({
  title: post.data.title,
  href: `/writing/${post.id}`,
  date: formatDate(post.data.date),
}))
---

<Layout
  title="Thoughts"
  description="Essays and notes on design, engineering, and building."
>
  <PageShell>
    <NavigationMenu segments={[{ label: "Thoughts" }]} client:idle />
    <div class="page-content">
      {
        posts.length > 0 ? (
          <ul class="writing-list">
            {posts.map((post) => (
              <li>
                <ArticleListItem {...post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="body-text">Nothing here yet.</p>
        )
      }
    </div>
  </PageShell>
</Layout>
