---
import Layout from "@/layouts/main.astro"
import SiteContainer from "@/components/SiteContainer.astro"
import ThoughtList from "@/components/ThoughtList.astro"
import { getCollection } from "astro:content"

const thoughts = (await getCollection("writing"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    title: post.data.title,
    href: `/writing/${post.id}`,
    date: post.data.date,
  }))
---

<Layout>
  <SiteContainer>
    <section class="section" aria-labelledby="thoughts-page-heading">
      <h1 class="title page-title" id="thoughts-page-heading">Thoughts</h1>
      {
        thoughts.length > 0 ? (
          <ThoughtList items={thoughts} />
        ) : (
          <p class="body-text">Nothing here yet.</p>
        )
      }
    </section>
  </SiteContainer>
</Layout>