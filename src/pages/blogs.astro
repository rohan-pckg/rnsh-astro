---
import Layout from "@/layouts/main.astro"
import LottiePlayer from "@/components/ui/lottie"
import DinoAnimation from "../../public/lottie/cat-peek.json"
import { getCollection } from "astro:content"

const posts = (await getCollection("writing"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout>
  <div class="flex min-h-svh justify-center px-2 py-32 sm:px-16">
    <div class="flex w-full max-w-md flex-col gap-4 text-sm leading-loose">
      <a href="/">
        <LottiePlayer
          animationData={DinoAnimation}
          className="h-8 w-8"
          client:visible
        />
      </a>
      <h1 class="my-6 font-medium">
        <span class="text-muted-foreground opacity-50"
          >Sharing my thoughts...</span
        >
      </h1>

      <div class="flex gap-8">
        <ul class="flex w-full flex-col gap-6">
          {
            posts.map((post) => (
              <li class="w-full">
                <a
                  href={`/writing/${post.slug}`}
                  class="group border-2transition-colors borde flex items-center justify-between"
                >
                  <div class="flex flex-col gap-1">
                    <span class="text-foreground underline hover:text-blue-400">
                      {post.data.title}
                    </span>

                    <span class="text-xs text-muted-foreground">
                      {post.data.date.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Layout>
