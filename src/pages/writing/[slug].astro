---
import ArticleLayout from "@/components/article/ArticleLayout.astro"
import NavigationMenu from "@/components/NavigationMenu"
import Layout from "@/layouts/main.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const posts = await getCollection("writing")
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)

const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0
const readingTime = Math.max(1, Math.ceil(wordCount / 210))
---

<Layout>
  <ArticleLayout
    headings={headings}
    title={post.data.title}
    description={post.data.description}
    date={post.data.date}
    category={post.data.category}
    readingTime={readingTime}
  >
    <div slot="nav">
      <NavigationMenu
        segments={[{ label: "Thoughts", href: "/blogs" }, { label: post.data.title }]}
        client:load
      />
    </div>

    <Content />
  </ArticleLayout>
</Layout>
