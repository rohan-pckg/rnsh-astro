---
import ArticleFooter from "@/components/article/ArticleFooter.astro"
import ArticleHeader from "@/components/article/ArticleHeader.astro"
import ArticleLayout from "@/components/article/ArticleLayout.astro"
import Layout from "@/layouts/main.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const posts = await getCollection("writing")
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const firstH1 = headings.find((heading) => heading.depth === 1)
const normalizeTitle = (value: string) =>
  value.trim().replace(/\s+/g, " ").toLowerCase()
const hideDuplicateTitle =
  firstH1 && normalizeTitle(firstH1.text) === normalizeTitle(post.data.title)
---

<Layout>
  <ArticleLayout headings={headings}>
    <ArticleHeader title={post.data.title} backHref="/blogs" />

    <div
      class={`article-content ${hideDuplicateTitle ? "article-content--hide-first-title" : ""}`}
    >
      <Content />
    </div>

    <ArticleFooter backHref="/blogs" backLabel="Back to writing" />
  </ArticleLayout>
</Layout>
